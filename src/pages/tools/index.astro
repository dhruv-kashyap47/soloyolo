---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import ToolCard from '@/components/ui/ToolCard.astro';
import { liveTools } from '@/lib/tools';

const calculators = liveTools('calculator');
const generators = liveTools('generator');
const total = calculators.length + generators.length;
---

<BaseLayout
  title="All business tools for independent work"
  description="Every SoloYolo calculator and document generator in one place: rates, profit, markup, fees, tax, invoices, quotes, receipts and reminders."
  path="/tools/"
>
  <div class="wrap pb-10 sm:pb-14">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools' }]} />

    <header class="max-w-2xl pt-8 sm:pt-12">
      <p class="eyebrow">All tools</p>
      <h1 class="mt-3 text-[clamp(2.1rem,1.4rem+3.4vw,3.4rem)] leading-[1.05] font-medium tracking-[-0.03em]">
        Every tool, in one place
      </h1>
      <p class="text-ink-soft mt-4 text-[1.0625rem] leading-relaxed sm:text-lg">
        {total} free tools for pricing, profit, tax and the documents you send. No account and
        nothing uploaded.
      </p>
    </header>

    <section class="mt-12 sm:mt-16" aria-labelledby="calculators">
      <div class="border-line flex flex-wrap items-baseline justify-between gap-3 border-b pb-3">
        <h2 id="calculators" class="text-2xl font-medium tracking-[-0.02em]">
          Calculators
        </h2>
        <span class="text-muted font-mono text-xs">
          {String(calculators.length).padStart(2, '0')}
        </span>
      </div>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {calculators.map((tool) => (
          <li>
            <ToolCard tool={tool} />
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-12 sm:mt-16" aria-labelledby="generators">
      <div class="border-line flex flex-wrap items-baseline justify-between gap-3 border-b pb-3">
        <h2 id="generators" class="text-2xl font-medium tracking-[-0.02em]">
          Generators
        </h2>
        <span class="text-muted font-mono text-xs">
          {String(generators.length).padStart(2, '0')}
        </span>
      </div>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {generators.map((tool) => (
          <li>
            <ToolCard tool={tool} />
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
