---
import AdSlot from '@/components/ads/AdSlot.astro';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ToolPageLayout from '@/components/layout/ToolPageLayout.astro';
import Section from '@/components/ui/Section.astro';
import { COUNTRIES } from '@/lib/countries';
import { COUNTRY_GUIDES, guidesForCountry } from '@/lib/countries/guides';
import { formatDate } from '@/lib/formatting/date';

const siteUrl = Astro.site ?? new URL('https://ledgerly.example.com');
const path = '/countries/';
const title = 'Invoice rules by country';
const description =
  'Compare invoice and tax invoice rules for eight markets: the US, UK, Canada, Australia, Germany, Switzerland, India and the UAE. Open a generator already set to the right currency and fields.';
const url = new URL(path, siteUrl).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url,
    isPartOf: {
      '@type': 'WebSite',
      name: 'SoloYolo',
      url: siteUrl.href,
    },
    hasPart: COUNTRY_GUIDES.map((guide) => ({
      '@type': 'WebPage',
      name: guide.name,
      url: new URL(guide.href, siteUrl).href,
    })),
  },
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <ToolPageLayout
    eyebrow="Country guides"
    title={title}
    description={description}
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Countries' }]}
  >
    <Section id="compare" title="One toolkit, eight sets of rules">
      <div class="prose-ledger">
        <p>
          The tax name, the registration number, the rates and the fields a tax invoice needs are
          different in each market. The generator reads one country configuration, so the same
          document engine prints the right currency, title and required fields for the market you
          choose.
        </p>
      </div>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[52rem] text-left text-sm">
          <thead>
            <tr class="border-line border-b">
              <th scope="col" class="py-2 pr-5 font-semibold text-ink">
                Market
              </th>
              <th scope="col" class="py-2 pr-5 font-semibold text-ink">
                Currency
              </th>
              <th scope="col" class="py-2 pr-5 font-semibold text-ink">
                Tax
              </th>
              <th scope="col" class="py-2 pr-5 font-semibold text-ink">
                Registration
              </th>
              <th scope="col" class="py-2 pr-5 font-semibold text-ink">
                Invoice title
              </th>
              <th scope="col" class="py-2 font-semibold text-ink">
                Checked
              </th>
            </tr>
          </thead>
          <tbody>
            {COUNTRIES.map((country) => (
              <tr class="border-line border-b last:border-0">
                <td class="py-3 pr-5 align-top">
                  <a
                    href={`#${country.code.toLowerCase()}`}
                    class="font-medium text-ink underline decoration-line-strong underline-offset-2 hover:text-accent-strong"
                  >
                    {country.name}
                  </a>
                </td>
                <td class="py-3 pr-5 align-top tabular-nums text-ink-soft">{country.currency}</td>
                <td class="py-3 pr-5 align-top text-ink-soft">{country.tax.name}</td>
                <td class="py-3 pr-5 align-top text-ink-soft">{country.tax.registrationLabel}</td>
                <td class="py-3 pr-5 align-top text-ink-soft">
                  {country.invoice.documentTitle}
                  {country.tax.supportsTaxInvoice &&
                  country.tax.taxInvoiceTitle !== country.invoice.documentTitle
                    ? ` / ${country.tax.taxInvoiceTitle}`
                    : ''}
                </td>
                <td class="py-3 align-top text-ink-soft">
                  {formatDate(country.verifiedOn, { currency: country.currency })}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>

    <aside class="ad-band mt-12 sm:mt-14" aria-label="Advertisement">
      <AdSlot format="top" />
    </aside>

    {COUNTRIES.map((country) => {
      const guides = guidesForCountry(country.code);
      return (
        <section
          id={country.code.toLowerCase()}
          class="mt-14 scroll-mt-8 sm:mt-16"
          aria-labelledby={`${country.code}-heading`}
        >
          <div class="max-w-3xl">
            <p class="eyebrow">{country.name}</p>
            <h2
              id={`${country.code}-heading`}
              class="mt-2 text-[clamp(1.6rem,1.3rem+1.5vw,2rem)] font-medium leading-tight tracking-[-0.02em]"
            >
              {country.tax.name} invoice rules in {country.name}
            </h2>
            <p class="mt-3 text-ink-soft">{country.tax.rateHint}</p>
          </div>

          <ul class="mt-5 grid gap-4 sm:grid-cols-2">
            {guides.map((guide) => (
              <li>
                <a href={guide.href} class="card card-hover group flex h-full flex-col p-5">
                  <span class="text-muted text-[0.6875rem] font-semibold tracking-[0.12em] uppercase">
                    {guide.taxInvoice ? 'Tax invoice' : 'Invoice'}
                  </span>
                  <span class="text-ink group-hover:text-accent-strong mt-1.5 text-[0.9375rem] font-semibold">
                    {guide.name}
                  </span>
                  <span class="text-ink-soft mt-1.5 text-sm leading-relaxed">{guide.summary}</span>
                  <span class="text-accent-strong mt-3 text-xs font-semibold">
                    Open the guide and generator
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}

    <aside class="ad-band mt-12 sm:mt-14" aria-label="Advertisement">
      <AdSlot format="inarticle" />
    </aside>

    <Section id="how-it-works" title="How the country layer works">
      <div class="prose-ledger">
        <p>
          Each market has one configuration behind the tool. It carries the currency, the tax name,
          the registration label, the rates, the tax invoice title and the fields that become
          required. The official source for every tax claim is stored beside it with the date the
          claim was checked.
        </p>
        <ul>
          <li>
            The generator never looks up a live rate and never sends an invoice anywhere. The rate
            you type is the rate on the sheet.
          </li>
          <li>
            A country page is fixed to its market, so the page copy and the printed document cannot
            disagree.
          </li>
          <li>
            The general invoice generator lets you switch country. The currency, tax name,
            registration label and line rates move with it.
          </li>
          <li>
            The tax invoice switch is only offered where the market has one: VAT in the UK and
            Germany, GST/HST in Canada, tax invoices in Australia, and GST or VAT tax invoices in
            India and the UAE.
          </li>
        </ul>
      </div>
    </Section>

    <Section id="tools" title="Put the rules to work">
      <div class="prose-ledger">
        <p>
          Start with the general <a href="/generators/invoice-generator/">invoice generator</a> or
          open a market page above. The{' '}
          <a href="/calculators/vat-gst-sales-tax-calculator/">VAT, GST and sales tax calculator</a>{' '}
          checks a rate, and the{' '}
          <a href="/calculators/payment-processing-fee-calculator/">payment fee calculator</a> shows
          what a card payment costs before you set a price.
        </p>
      </div>
    </Section>

    <aside class="ad-band mt-14 max-w-xl" aria-label="Advertisement">
      <AdSlot format="end" />
    </aside>
  </ToolPageLayout>
</BaseLayout>
