---
import Decimal from 'decimal.js';

import RetainerCalculator from '@/components/calculators/RetainerCalculator';
import AdSlot from '@/components/ads/AdSlot.astro';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ToolPageLayout from '@/components/layout/ToolPageLayout.astro';
import Callout from '@/components/ui/Callout.astro';
import FAQList from '@/components/ui/FAQList.astro';
import RelatedTools from '@/components/ui/RelatedTools.astro';
import Section from '@/components/ui/Section.astro';
import {
  RETAINER_ASSUMPTIONS,
  RETAINER_EXAMPLES,
  RETAINER_FAQ,
  RETAINER_META,
  RETAINER_RELATED_CALCULATORS,
} from '@/data/calculators/retainer';
import { validateRetainerContent } from '@/data/calculators/retainer.schema';
import { calculateRetainer } from '@/lib/calculators/retainer';
import { formatCurrency } from '@/lib/formatting/currency';
import { formatPercent } from '@/lib/formatting/number';
import { liveTools } from '@/lib/tools';

validateRetainerContent();

const meta = RETAINER_META;
const siteUrl = Astro.site ?? new URL('https://ledgerly.example.com');
const otherTools = liveTools('calculator').filter((tool) => tool.href !== meta.path);

const examples = RETAINER_EXAMPLES.map((example) => {
  const outcome = calculateRetainer({
    monthlyHours: new Decimal(example.inputs.monthlyHours),
    hourlyRate: new Decimal(example.inputs.hourlyRate),
    monthlyExpenses: new Decimal(example.inputs.monthlyExpenses),
    desiredMarginPercent: new Decimal(example.inputs.desiredMarginPercent),
    discountPercent: new Decimal(example.inputs.discountPercent),
  });

  if (!outcome.ok) {
    throw new Error(`Worked example "${example.id}" does not calculate: ${outcome.message}`);
  }

  return { ...example, value: outcome.value };
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: meta.title,
    description: meta.description,
    url: new URL(meta.path, siteUrl).href,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isPartOf: { '@type': 'WebSite', name: 'SoloYolo', url: siteUrl.href },
  },
];
---

<BaseLayout
  title={`${meta.title} for freelancers and consultants`}
  description={meta.description}
  path={meta.path}
  jsonLd={jsonLd}
>
  <ToolPageLayout
    eyebrow={meta.eyebrow}
    title={meta.title}
    description={meta.intro}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Calculators', href: '/calculators/' },
      { label: 'Retainer Pricing Calculator' },
    ]}
    sidebar
  >
    <div id="calculator" class="scroll-mt-24">
      <RetainerCalculator client:load />
    </div>

    <div class="mt-12 max-w-3xl sm:mt-14">
      <AdSlot format="top" label="Advertisement" />
    </div>

    <Section id="how-it-works" title="How it works">
      <div class="prose-ledger">
        <p>
          A retainer is a fixed monthly price for committed capacity. It has to cover three things:
          the hours you reserve for the client, the costs their work carries, and the profit that
          makes the arrangement worth keeping. Multiply hours by a rate and you have only done the
          first one.
        </p>
        <p>
          The calculator starts with your <strong>base cost</strong>: committed hours multiplied by
          your internal rate, plus monthly expenses. It then adds the <strong>desired margin</strong>{' '}
          by dividing by one minus the margin, not by multiplying. That is what makes the margin a
          share of the price rather than a share of the cost.
        </p>
        <p>
          The <strong>discount</strong> is applied last, to the list price, and it comes straight out
          of the margin. A 10% discount on a 30% margin leaves roughly 22%; a 15% discount on a 20%
          margin leaves under 6%. The panel shows the margin actually achieved, which is the number
          that matters after the negotiation.
        </p>
        <p>
          The effective hourly rate is the retainer divided by committed hours. It is often much
          higher than the rate the work is costed at, and that is correct: the gap is the margin and
          the expenses, not overcharging.
        </p>
      </div>
    </Section>

    <div class="mt-12 max-w-3xl sm:mt-14">
      <AdSlot format="inarticle" label="Advertisement" />
    </div>

    <Section id="formula" title="The formula">
      <div class="prose-ledger">
        <p>Cost, then margin on price, then the discount:</p>
      </div>
      <pre
        class="formula mt-4 max-w-3xl"
        tabindex="0"
        role="region"
        aria-label="Retainer formula"
      ><code>base cost = hours × rate + monthly expenses
quote     = base cost ÷ (1 − margin)
retainer  = quote × (1 − discount)
profit    = retainer − base cost</code></pre>
      <div class="prose-ledger mt-4">
        <p>
          In the default example, 20 hours at $90 plus $600 of expenses is $2,400 of base cost. A 30%
          margin turns that into a $3,428.57 quote. With no discount, the retainer is{' '}
          <strong>$3,428.57</strong>: $1,028.57 of profit and an effective $171.43 an hour.
        </p>
        <p>
          Dividing by 1 − margin is what keeps margin a share of the price. Multiplying by 1.3 would
          add 30% of cost, which is a markup, and would leave a 23% margin instead of 30%.
        </p>
      </div>
    </Section>

    <Section id="worked-examples" title="Worked examples" width="wide">
      <div class="grid gap-4">
        {examples.map((example) => (
          <article class="card p-5 sm:p-6">
            <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
              <div>
                <h3 class="text-base font-semibold text-ink">{example.name}</h3>
                <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-soft">
                  {example.scenario}
                </p>
                <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink-soft">
                  <strong class="font-semibold text-ink">What this shows:</strong>{' '}
                  {example.takeaway}
                </p>
              </div>

              <dl class="divide-y divide-line rounded-lg border border-line bg-canvas/60 px-4">
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Base cost</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(example.value.baseCost, example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Discount</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(example.value.discountAmount, example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Effective hourly</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(example.value.effectiveHourlyRounded, example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Monthly profit</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(example.value.profitRounded, example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Achieved margin</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {example.value.achievedMargin === null
                      ? '—'
                      : formatPercent(example.value.achievedMargin)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-xs font-semibold text-accent-strong">Retainer</dt>
                  <dd class="text-base font-semibold tabular-nums text-accent-strong">
                    {formatCurrency(example.value.retainerRounded, example.currency)}/mo
                  </dd>
                </div>
              </dl>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-8">
        <a
          href="#calculator"
          class="link-draw inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-accent-strong"
        >
          Price your own retainer
          <span aria-hidden="true">&uarr;</span>
        </a>
      </p>
    </Section>

    <Section id="assumptions" title="Assumptions and limitations">
      <div class="prose-ledger">
        <ul>
          {RETAINER_ASSUMPTIONS.map((assumption) => (
            <li>{assumption}</li>
          ))}
        </ul>
      </div>

      <div class="mt-6 max-w-3xl">
        <Callout variant="warn" title="Not tax or financial advice">
          <p>
            This calculator is an informational planning tool. It does not know your tax residency,
            entity structure or deductions, and it does not calculate income tax, VAT, GST or sales
            tax. Check your obligations with the tax authority in your country or a qualified
            accountant before relying on the result.
          </p>
        </Callout>
      </div>
    </Section>

    <FAQList faqs={RETAINER_FAQ} />

    <div class="mt-14 max-w-3xl">
      <AdSlot format="end" label="Advertisement" />
    </div>

    <RelatedTools ids={RETAINER_RELATED_CALCULATORS} title="Related calculators" />

    <div slot="sidebar">
      <AdSlot format="sidebar" label="Advertisement" />
      {
        otherTools.length > 0 && (
          <nav aria-label="Quick tools" class="mt-6 card p-5">
            <p class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">
              Quick links
            </p>
            <ul class="mt-3 grid gap-2.5 text-sm">
              <li>
                <a href="/calculators/" class="link-draw inline-block text-ink-soft hover:text-ink">
                  All calculators
                </a>
              </li>
              {otherTools.map((tool) => (
                <li>
                  <a href={tool.href} class="link-draw inline-block text-ink-soft hover:text-ink">
                    {tool.name}
                  </a>
                </li>
              ))}
              <li>
                <a href="/about/" class="link-draw inline-block text-ink-soft hover:text-ink">
                  About SoloYolo
                </a>
              </li>
            </ul>
          </nav>
        )
      }
    </div>
  </ToolPageLayout>
</BaseLayout>
