---
import AdSlot from '@/components/ads/AdSlot.astro';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Callout from '@/components/ui/Callout.astro';
import ToolCard from '@/components/ui/ToolCard.astro';
import { liveTools } from '@/lib/tools';

const calculators = liveTools('calculator');
// Read the generator names from the registry, not a second local list that
// would silently drift when a generator is renamed.
const generators = liveTools('generator');
---

<BaseLayout
  title="Business calculators for freelancers and small businesses"
  description="Free, private calculators for freelance rates, project profit, markup and margin, payment fees, VAT/GST, retainers and break-even. No sign-up required."
  path="/calculators/"
>
  <div class="wrap">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Calculators' }]} />

    <div class="grid grid-cols-12 gap-6 pt-8 pb-10 sm:pt-12 sm:pb-14 lg:items-start">
      <div class="col-span-12 lg:col-span-5">
        <p class="eyebrow">Calculators</p>
        <h1 class="mt-3 text-[clamp(2.1rem,1.4rem+3.4vw,3.4rem)] font-medium leading-[1.05] tracking-[-0.03em]">
          Business calculators for independent work
        </h1>
        <p class="mt-4 max-w-lg text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg">
          Work out what to charge, what a project really earns, and what you keep after fees and
          tax. Every calculator runs in your browser with exact decimal arithmetic.
        </p>
        <p class="mt-5 text-sm text-ink-soft">
          Every calculator is free, with no account and no uploads.
        </p>
        <a href="/calculators/hourly-rate-calculator/" class="btn btn-primary mt-7">
          Open the hourly rate calculator
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h9.5M9 4.5 12.5 8 9 11.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
      </div>

      <div class="col-span-12 lg:col-span-6 lg:col-start-7">
        <ul class="grid gap-4">
          {calculators.map((tool) => (
            <li>
              <ToolCard tool={tool} />
            </li>
          ))}
        </ul>
      </div>
    </div>

    <aside class="ad-band mt-12 sm:mt-14" aria-label="Advertisement">
      <AdSlot format="top" />
    </aside>

    <section class="mt-14 sm:mt-16" aria-labelledby="generators">
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 lg:col-span-5">
          <h2
            id="generators"
            class="text-[clamp(1.6rem,1.3rem+1.5vw,2rem)] font-medium tracking-[-0.02em]"
          >
            Turn the numbers into documents
          </h2>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-ink-soft">
            The generators turn those numbers into the documents a customer expects: invoices,
            quotes, receipts and the reminder you have been avoiding.
          </p>
          <a href="/generators/" class="btn btn-secondary mt-5">
            Open the generators
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M3 8h9.5M9 4.5 12.5 8 9 11.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </a>
        </div>

        <div class="col-span-12 lg:col-span-6 lg:col-start-7">
          <ul class="flex flex-wrap gap-2">
            {generators.map((tool) => (
              <li>
                <a
                  href={tool.href}
                  class="inline-flex rounded-full border border-line bg-surface px-3 py-1.5 text-sm text-ink-soft hover:border-line-strong hover:text-ink"
                >
                  {tool.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-12 gap-6">
        <div class="col-span-12 lg:col-span-5">
          <Callout variant="info" title="How these tools stay accurate">
            <p>
              Financial results are calculated with decimal arithmetic, not binary floating point,
              and every formula is covered by unit tests for normal values, zero, negatives,
              decimals, rounding and extreme inputs. Calculators are informational tools and do not
              constitute tax, accounting or financial advice.
            </p>
          </Callout>
        </div>
      </div>
    </section>

    <aside class="ad-band mt-12 sm:mt-14" aria-label="Advertisement">
      <AdSlot format="inarticle" />
    </aside>

    <div class="closing-panel sq mt-12 sm:mt-14">
      <div>
        <h2 class="mt-2 max-w-[30ch] text-[clamp(1.35rem,1.2rem+1vw,1.75rem)] font-medium tracking-[-0.02em]">
          Two minutes with your own numbers beats another guess.
        </h2>
      </div>
      <div class="closing-actions">
        <a href="/calculators/hourly-rate-calculator/" class="btn btn-primary">
          Open the hourly rate calculator
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h9.5M9 4.5 12.5 8 9 11.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <aside class="ad-band mt-12 mb-6 sm:mt-14" aria-label="Advertisement">
      <AdSlot format="end" />
    </aside>
  </div>
</BaseLayout>
