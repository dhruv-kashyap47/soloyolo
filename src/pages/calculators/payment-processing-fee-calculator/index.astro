---
import Decimal from 'decimal.js';

import PaymentFeeCalculator from '@/components/calculators/PaymentFeeCalculator';
import AdSlot from '@/components/ads/AdSlot.astro';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ToolPageLayout from '@/components/layout/ToolPageLayout.astro';
import Callout from '@/components/ui/Callout.astro';
import FAQList from '@/components/ui/FAQList.astro';
import RelatedTools from '@/components/ui/RelatedTools.astro';
import Section from '@/components/ui/Section.astro';
import {
  PAYMENT_FEE_ASSUMPTIONS,
  PAYMENT_FEE_EXAMPLES,
  PAYMENT_FEE_FAQ,
  PAYMENT_FEE_META,
  PAYMENT_FEE_RELATED_CALCULATORS,
} from '@/data/calculators/payment-fee';
import { validatePaymentFeeContent } from '@/data/calculators/payment-fee.schema';
import { calculatePaymentFee } from '@/lib/calculators/paymentFee';
import { formatCurrency } from '@/lib/formatting/currency';
import { formatPercent } from '@/lib/formatting/number';
import { liveTools } from '@/lib/tools';

validatePaymentFeeContent();

const meta = PAYMENT_FEE_META;
const siteUrl = Astro.site ?? new URL('https://soloyolotools.com');
const otherTools = liveTools('calculator').filter((tool) => tool.href !== meta.path);

const examples = PAYMENT_FEE_EXAMPLES.map((example) => {
  const outcome = calculatePaymentFee({
    amount: new Decimal(example.inputs.amount),
    percentFee: new Decimal(example.inputs.percentFee),
    fixedFee: new Decimal(example.inputs.fixedFee),
  });

  if (!outcome.ok) {
    throw new Error(`Worked example "${example.id}" does not calculate: ${outcome.message}`);
  }

  return { ...example, value: outcome.value };
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: meta.title,
    description: meta.description,
    url: new URL(meta.path, siteUrl).href,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isPartOf: { '@type': 'WebSite', name: 'soloyolo', url: siteUrl.href },
  },
];
---

<BaseLayout
  title={`${meta.title} for freelancers and small businesses`}
  description={meta.description}
  path={meta.path}
  jsonLd={jsonLd}
>
  <ToolPageLayout
    eyebrow={meta.eyebrow}
    title={meta.title}
    description={meta.intro}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Calculators', href: '/calculators/' },
      { label: 'Payment Fee Calculator' },
    ]}
    sidebar
  >
    <div id="calculator" class="scroll-mt-24">
      <PaymentFeeCalculator client:load />
    </div>

    <div class="mt-12 max-w-3xl sm:mt-14">
      <AdSlot format="top" label="Advertisement" />
    </div>

    <Section id="how-it-works" title="How it works">
      <div class="prose-ledger">
        <p>
          A card processor charges two things at once: a percentage of the payment and a flat fee per
          transaction. Both come out before the money reaches you, and the flat fee is the part that
          surprises people, because it does not shrink with the payment.
        </p>
        <p>
          The calculator takes the payment amount and the two fee components, then shows the fee, the
          net that lands in your account, and the <strong>effective rate</strong>: the total fee
          divided by the amount. On a large invoice the effective rate sits close to the headline
          percentage. On a small one it can be several times higher.
        </p>
        <p>
          No processor rates are included. Rates vary by processor, country, card type, turnover and
          negotiation, and they change. Enter the rate from your own statement, and the answer is
          correct for your account today rather than for an average that may never have existed.
        </p>
        <p>
          If the fee is larger than the payment, the net goes negative and the panel says so. That is
          not a bug: it is what happens when a fixed fee meets a very small transaction, and it is
          usually the signal to set a minimum card payment.
        </p>
      </div>
    </Section>

    <div class="mt-12 max-w-3xl sm:mt-14">
      <AdSlot format="inarticle" label="Advertisement" />
    </div>

    <Section id="formula" title="The formula">
      <div class="prose-ledger">
        <p>Two charges, one subtraction:</p>
      </div>
      <pre
        class="formula mt-4 max-w-3xl"
        tabindex="0"
        role="region"
        aria-label="Payment fee formula"
      ><code>fee            = amount × percentage fee + fixed fee
net            = amount − fee
effective rate = fee ÷ amount</code></pre>
      <div class="prose-ledger mt-4">
        <p>
          In the default example, 2.9% of $1,000 is $29.00, plus $0.30, so the fee is{' '}
          <strong>$29.30</strong> and the net is <strong>$970.70</strong>. The effective rate is
          2.9%.
        </p>
        <p>
          The same fee structure on a $45 payment takes 1.09 in fees and lands 43.91. The percentage
          part is under 79 cents; the rest is the fixed fee. That is why the effective rate on small
          payments is always the number worth looking at, not the advertised percentage.
        </p>
      </div>
    </Section>

    <Section id="worked-examples" title="Worked examples" width="wide">
      <div class="grid gap-4">
        {examples.map((example) => (
          <article class="card p-5 sm:p-6">
            <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
              <div>
                <h3 class="text-base font-semibold text-ink">{example.name}</h3>
                <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-soft">
                  {example.scenario}
                </p>
                <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink-soft">
                  <strong class="font-semibold text-ink">What this shows:</strong>{' '}
                  {example.takeaway}
                </p>
              </div>

              <dl class="divide-y divide-line rounded-lg border border-line bg-canvas/60 px-4">
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Payment</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(example.value.amountRounded, example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Total fee</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(example.value.totalFeeRounded, example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Effective rate</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {example.value.effectivePercent === null
                      ? '—'
                      : formatPercent(example.value.effectivePercent)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-xs font-semibold text-accent-strong">Net received</dt>
                  <dd class="text-base font-semibold tabular-nums text-accent-strong">
                    {formatCurrency(example.value.netRounded, example.currency)}
                  </dd>
                </div>
              </dl>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-8">
        <a
          href="#calculator"
          class="link-draw inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-accent-strong"
        >
          Check your own rates
          <span aria-hidden="true">&uarr;</span>
        </a>
      </p>
    </Section>

    <Section id="assumptions" title="Assumptions and limitations">
      <div class="prose-ledger">
        <ul>
          {PAYMENT_FEE_ASSUMPTIONS.map((assumption) => (
            <li>{assumption}</li>
          ))}
        </ul>
      </div>

      <div class="mt-6 max-w-3xl">
        <Callout variant="warn" title="Not tax or financial advice">
          <p>
            This calculator is an informational planning tool. It does not know your processor
            contract, your tax position or the rules on passing fees to clients. Check the terms with
            your processor and the rules in your country before adding a card surcharge or relying on
            the result.
          </p>
        </Callout>
      </div>
    </Section>

    <FAQList faqs={PAYMENT_FEE_FAQ} />

    <div class="mt-14 max-w-3xl">
      <AdSlot format="end" label="Advertisement" />
    </div>

    <RelatedTools ids={PAYMENT_FEE_RELATED_CALCULATORS} title="Related calculators" />

    <div slot="sidebar">
      <AdSlot format="sidebar" label="Advertisement" />
      {
        otherTools.length > 0 && (
          <nav aria-label="Quick tools" class="mt-6 card p-5">
            <p class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">
              Quick links
            </p>
            <ul class="mt-3 grid gap-2.5 text-sm">
              <li>
                <a href="/calculators/" class="link-draw inline-block text-ink-soft hover:text-ink">
                  All calculators
                </a>
              </li>
              {otherTools.map((tool) => (
                <li>
                  <a href={tool.href} class="link-draw inline-block text-ink-soft hover:text-ink">
                    {tool.name}
                  </a>
                </li>
              ))}
              <li>
                <a href="/about/" class="link-draw inline-block text-ink-soft hover:text-ink">
                  About soloyolo
                </a>
              </li>
            </ul>
          </nav>
        )
      }
    </div>
  </ToolPageLayout>
</BaseLayout>
