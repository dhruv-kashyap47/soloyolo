---
import BreakEvenCalculator from '@/components/calculators/BreakEvenCalculator';
import AdSlot from '@/components/ads/AdSlot.astro';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ToolPageLayout from '@/components/layout/ToolPageLayout.astro';
import Callout from '@/components/ui/Callout.astro';
import FAQList from '@/components/ui/FAQList.astro';
import RelatedTools from '@/components/ui/RelatedTools.astro';
import Section from '@/components/ui/Section.astro';
import {
  BREAK_EVEN_ASSUMPTIONS,
  BREAK_EVEN_EXAMPLES,
  BREAK_EVEN_FAQ,
  BREAK_EVEN_META,
  BREAK_EVEN_RELATED_CALCULATORS,
  toBreakEvenInput,
} from '@/data/calculators/break-even';
import { validateBreakEvenContent } from '@/data/calculators/break-even.schema';
import { calculateBreakEven } from '@/lib/calculators/breakEven';
import { formatCurrency } from '@/lib/formatting/currency';
import { formatNumber } from '@/lib/formatting/number';
import { liveTools } from '@/lib/tools';

validateBreakEvenContent();

const meta = BREAK_EVEN_META;
const siteUrl = Astro.site ?? new URL('https://soloyolotools.com');
const otherTools = liveTools('calculator').filter((tool) => tool.href !== meta.path);

const examples = BREAK_EVEN_EXAMPLES.map((example) => {
  const outcome = calculateBreakEven(toBreakEvenInput(example.inputs));

  if (!outcome.ok) {
    throw new Error(`Worked example "${example.id}" does not calculate: ${outcome.message}`);
  }

  return { ...example, value: outcome.value };
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: meta.title,
    description: meta.description,
    url: new URL(meta.path, siteUrl).href,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isPartOf: { '@type': 'WebSite', name: 'soloyolo', url: siteUrl.href },
  },
];
---

<BaseLayout
  title={`${meta.title} for freelancers and small businesses`}
  description={meta.description}
  path={meta.path}
  jsonLd={jsonLd}
>
  <ToolPageLayout
    eyebrow={meta.eyebrow}
    title={meta.title}
    description={meta.intro}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Calculators', href: '/calculators/' },
      { label: 'Break-even Calculator' },
    ]}
    sidebar
  >
    <div id="calculator" class="scroll-mt-24">
      <BreakEvenCalculator client:load />
    </div>

    <div class="mt-12 max-w-3xl sm:mt-14">
      <AdSlot format="top" label="Advertisement" />
    </div>

    <Section id="how-it-works" title="How it works">
      <div class="prose-ledger">
        <p>
          Break-even is the point where the money coming in covers the money that has to go out.
          Fixed costs (rent, software, insurance, accounting, your own target pay) are paid whether
          or not a single sale happens. Variable costs only exist when you sell: materials,
          subcontractors, delivery, payment fees.
        </p>
        <p>
          The difference between the price and the variable cost is the <strong>contribution</strong>.
          Every sale adds that amount towards the fixed costs. Divide fixed costs by the contribution
          and you have the number of sales needed to cover the month. Divide the other way, price
          minus variable cost, and a sale that looks profitable can contribute almost nothing.
        </p>
        <p>
          The calculator works per project or per hour. Per project is for fixed-scope work where you
          know roughly how long one takes; per hour is for work you bill by the clock. The per-project
          mode also reports the hours behind the break-even point, which is usually the figure that
          decides whether the month is physically possible.
        </p>
        <p>
          If the price is at or below the variable cost, there is no break-even to find: selling more
          makes the loss bigger. The tool says that plainly instead of returning an impossible number.
        </p>
      </div>
    </Section>

    <div class="mt-12 max-w-3xl sm:mt-14">
      <AdSlot format="inarticle" label="Advertisement" />
    </div>

    <Section id="formula" title="The formula">
      <div class="prose-ledger">
        <p>Contribution first, then the division:</p>
      </div>
      <pre
        class="formula mt-4 max-w-3xl"
        tabindex="0"
        role="region"
        aria-label="Break-even formula"
      ><code>contribution = price − variable cost
units        = fixed costs ÷ contribution
revenue      = units × price
hours        = units × hours per project</code></pre>
      <div class="prose-ledger mt-4">
        <p>
          In the default example, a $1,500 project with $500 of variable cost contributes $1,000.
          Against $4,000 of monthly fixed costs that is 4 projects, $6,000 of revenue and 80 hours of
          work. The fifth project is the first one that adds profit rather than covering overhead.
        </p>
        <p>
          Units are rounded up for the headline, because six and a half projects does not cover the
          month. Revenue is calculated at the exact break-even point, so the two figures intentionally
          describe slightly different things.
        </p>
      </div>
    </Section>

    <Section id="worked-examples" title="Worked examples" width="wide">
      <div class="grid gap-4">
        {examples.map((example) => (
          <article class="card p-5 sm:p-6">
            <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
              <div>
                <h3 class="text-base font-semibold text-ink">{example.name}</h3>
                <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-soft">
                  {example.scenario}
                </p>
                <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink-soft">
                  <strong class="font-semibold text-ink">What this shows:</strong>{' '}
                  {example.takeaway}
                </p>
              </div>

              <dl class="divide-y divide-line rounded-lg border border-line bg-canvas/60 px-4">
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Contribution</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(example.value.contributionPerUnit, example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Exact break-even</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatNumber(example.value.breakEvenUnits, {
                      decimals: example.value.breakEvenUnits.isInteger() ? 0 : 1,
                    })}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Break-even revenue</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(example.value.revenueRounded, example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Hours needed</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {example.value.breakEvenHours === null
                      ? '—'
                      : `${formatNumber(example.value.breakEvenHours, {
                          decimals: example.value.breakEvenHours.isInteger() ? 0 : 1,
                        })} h`}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-xs font-semibold text-accent-strong">Whole units</dt>
                  <dd class="text-base font-semibold tabular-nums text-accent-strong">
                    {formatNumber(example.value.unitsRoundedUp)}
                  </dd>
                </div>
              </dl>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-8">
        <a
          href="#calculator"
          class="link-draw inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-accent-strong"
        >
          Find your own break-even
          <span aria-hidden="true">&uarr;</span>
        </a>
      </p>
    </Section>

    <Section id="assumptions" title="Assumptions and limitations">
      <div class="prose-ledger">
        <ul>
          {BREAK_EVEN_ASSUMPTIONS.map((assumption) => (
            <li>{assumption}</li>
          ))}
        </ul>
      </div>

      <div class="mt-6 max-w-3xl">
        <Callout variant="info" title="Put your own pay in the fixed costs">
          <p>
            Break-even only means something if it includes the income you need. Add your target
            monthly pay to the fixed costs and the number becomes the point where the business pays
            you, not just the point where it survives.
          </p>
        </Callout>
      </div>

      <div class="mt-6 max-w-3xl">
        <Callout variant="warn" title="Not tax or financial advice">
          <p>
            This calculator is an informational planning tool. It does not know your tax residency,
            entity structure or deductions, and it does not calculate income tax, VAT, GST or sales
            tax. Check your obligations with the tax authority in your country or a qualified
            accountant before relying on the result.
          </p>
        </Callout>
      </div>
    </Section>

    <FAQList faqs={BREAK_EVEN_FAQ} />

    <div class="mt-14 max-w-3xl">
      <AdSlot format="end" label="Advertisement" />
    </div>

    <RelatedTools ids={BREAK_EVEN_RELATED_CALCULATORS} title="Related calculators" />

    <div slot="sidebar">
      <AdSlot format="sidebar" label="Advertisement" />
      {
        otherTools.length > 0 && (
          <nav aria-label="Quick tools" class="mt-6 card p-5">
            <p class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">
              Quick links
            </p>
            <ul class="mt-3 grid gap-2.5 text-sm">
              <li>
                <a href="/calculators/" class="link-draw inline-block text-ink-soft hover:text-ink">
                  All calculators
                </a>
              </li>
              {otherTools.map((tool) => (
                <li>
                  <a href={tool.href} class="link-draw inline-block text-ink-soft hover:text-ink">
                    {tool.name}
                  </a>
                </li>
              ))}
              <li>
                <a href="/about/" class="link-draw inline-block text-ink-soft hover:text-ink">
                  About soloyolo
                </a>
              </li>
            </ul>
          </nav>
        )
      }
    </div>
  </ToolPageLayout>
</BaseLayout>
