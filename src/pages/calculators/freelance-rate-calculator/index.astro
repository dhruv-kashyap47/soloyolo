---
import Decimal from 'decimal.js';

import FreelanceRateCalculator from '@/components/calculators/FreelanceRateCalculator';
import AdSlot from '@/components/ads/AdSlot.astro';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ToolPageLayout from '@/components/layout/ToolPageLayout.astro';
import Callout from '@/components/ui/Callout.astro';
import FAQList from '@/components/ui/FAQList.astro';
import RelatedTools from '@/components/ui/RelatedTools.astro';
import Section from '@/components/ui/Section.astro';
import {
  FREELANCE_RATE_ASSUMPTIONS,
  FREELANCE_RATE_EXAMPLES,
  FREELANCE_RATE_FAQ,
  FREELANCE_RATE_META,
  FREELANCE_RATE_RELATED_CALCULATORS,
} from '@/data/calculators/freelance-rate';
import { validateFreelanceRateContent } from '@/data/calculators/freelance-rate.schema';
import { calculateFreelanceRate } from '@/lib/calculators/freelanceRate';
import { formatCurrency } from '@/lib/formatting/currency';
import { formatNumber } from '@/lib/formatting/number';
import { liveTools } from '@/lib/tools';

validateFreelanceRateContent();

const meta = FREELANCE_RATE_META;
const siteUrl = Astro.site ?? new URL('https://soloyolotools.com');
const otherTools = liveTools('calculator').filter((tool) => tool.href !== meta.path);

const hours = (value: Decimal) => formatNumber(value, { decimals: value.isInteger() ? 0 : 1 });

// Worked examples are computed with the real calculator at build time, so the
// figures on the page can never drift from the figures the tool produces.
const examples = FREELANCE_RATE_EXAMPLES.map((example) => {
  const outcome = calculateFreelanceRate({
    desiredIncome: new Decimal(example.inputs.desiredIncome),
    annualExpenses: new Decimal(example.inputs.annualExpenses),
    workingWeeks: new Decimal(example.inputs.workingWeeks),
    workingHoursPerWeek: new Decimal(example.inputs.workingHoursPerWeek),
    nonBillablePercent: new Decimal(example.inputs.nonBillablePercent),
    profitBufferPercent: new Decimal(example.inputs.profitBufferPercent),
  });

  if (!outcome.ok) {
    throw new Error(`Worked example "${example.id}" does not calculate: ${outcome.message}`);
  }

  return { ...example, value: outcome.value };
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: meta.title,
    description: meta.description,
    url: new URL(meta.path, siteUrl).href,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    isPartOf: {
      '@type': 'WebSite',
      name: 'soloyolo',
      url: siteUrl.href,
    },
  },
];
---

<BaseLayout
  title={`${meta.title} for freelancers and consultants`}
  description={meta.description}
  path={meta.path}
  jsonLd={jsonLd}
>
  <ToolPageLayout
    eyebrow={meta.eyebrow}
    title={meta.title}
    description={meta.intro}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Calculators', href: '/calculators/' },
      { label: 'Freelance Rate Calculator' },
    ]}
    sidebar
  >
    <div id="calculator" class="scroll-mt-24">
      <FreelanceRateCalculator client:load />
    </div>

    <div class="mt-12 max-w-3xl sm:mt-14">
      <AdSlot format="top" label="Advertisement" />
    </div>

    <Section id="how-it-works" title="How it works">
      <div class="prose-ledger">
        <p>
          A sustainable rate is built from the week you actually have, not the week you wish you
          had. This calculator asks for the hours you work, then removes the share you cannot
          invoice. What is left is your billable capacity, and every pound, dollar or euro you need
          has to come out of it.
        </p>
        <p>
          Start with <strong>target income</strong> and <strong>annual business expenses</strong>.
          Together they are the revenue the business has to produce before it pays you a penny of
          profit. Add the <strong>profit buffer</strong> and that revenue grows by the percentage you
          choose: the buffer is the slack that absorbs a quiet month, a broken laptop or a tax bill
          without turning into debt.
        </p>
        <p>
          Then look at capacity. <strong>Working weeks</strong> is the part of the year you actually
          work, after holidays and sick leave. <strong>Working hours per week</strong> is everything
          you do in a week, including the admin, proposals, invoicing, sales calls and learning that
          never appear on an invoice. <strong>Non-billable time</strong> is the share of that week
          you cannot bill, entered as a percentage.
        </p>
        <p>
          The result is the rate at which a normal week funds your plan. It is deliberately a floor:
          work that is urgent, risky, fixed-price or unusually demanding should be priced above it.
        </p>
        <p>
          The form opens with a worked example ($90,000 of income, $15,000 of costs, 46 weeks of 40
          hours, 40% non-billable and a 10% buffer), so the shape of the calculation is visible
          before you replace the numbers with your own.
        </p>
      </div>
    </Section>

    <div class="mt-12 max-w-3xl sm:mt-14">
      <AdSlot format="inarticle" label="Advertisement" />
    </div>

    <Section id="formula" title="The formula">
      <div class="prose-ledger">
        <p>
          Two steps: work out the revenue you need, then divide it by the hours you can invoice.
        </p>
      </div>
      <pre
        class="formula mt-4 max-w-3xl"
        tabindex="0"
        role="region"
        aria-label="Freelance rate formula"
      ><code>billable hours = weeks × hours per week × (1 − non-billable %)
revenue        = (income + expenses) × (1 + buffer %)
hourly rate    = revenue ÷ billable hours</code></pre>
      <div class="prose-ledger mt-4">
        <p>
          In the default example the working year is <code>46 × 40 = 1,840</code> hours. With 40%
          non-billable that leaves <code>1,104</code> billable hours. Income and costs come to{' '}
          <code>$105,000</code>; the 10% buffer adds <code>$10,500</code>, so the revenue to bill is{' '}
          <code>$115,500</code>. Divided by 1,104 hours, that is <strong>$104.62 an hour</strong>{' '}
          after rounding to the nearest cent.
        </p>
        <p>
          The exact rate is kept at full precision internally and rounded half-up only for display,
          so multiplying the shown rate back out will not always reproduce the annual total to the
          cent. The “exact rate” line under the result shows the unrounded value.
        </p>
      </div>
    </Section>

    <Section id="worked-examples" title="Worked examples" width="wide">
      <div class="grid gap-4">
        {examples.map((example) => (
          <article class="card p-5 sm:p-6">
            <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
              <div>
                <h3 class="text-base font-semibold text-ink">{example.name}</h3>
                <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-soft">
                  {example.scenario}
                </p>
                <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink-soft">
                  <strong class="font-semibold text-ink">What this shows:</strong>{' '}
                  {example.takeaway}
                </p>
              </div>

              <dl class="divide-y divide-line rounded-lg border border-line bg-canvas/60 px-4">
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Target income</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(new Decimal(example.inputs.desiredIncome), example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Annual expenses</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(new Decimal(example.inputs.annualExpenses), example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Billable capacity</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {hours(example.value.billableHoursPerYear)} h
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Revenue to bill</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(example.value.requiredAnnualRevenue, example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Buffer included</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(example.value.bufferAmount, example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-xs font-semibold text-accent-strong">Required rate</dt>
                  <dd class="text-base font-semibold tabular-nums text-accent-strong">
                    {formatCurrency(example.value.hourlyRateRounded, example.currency)}/h
                  </dd>
                </div>
              </dl>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-8">
        <a
          href="#calculator"
          class="link-draw inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-accent-strong"
        >
          Calculate your own numbers
          <span aria-hidden="true">&uarr;</span>
        </a>
      </p>
    </Section>

    <Section id="assumptions" title="Assumptions and limitations">
      <div class="prose-ledger">
        <ul>
          {FREELANCE_RATE_ASSUMPTIONS.map((assumption) => (
            <li>{assumption}</li>
          ))}
        </ul>
      </div>

      <div class="mt-6 max-w-3xl">
        <Callout variant="warn" title="Not tax or financial advice">
          <p>
            This calculator is an informational planning tool. It does not know your tax residency,
            entity structure or deductions, and it does not calculate income tax, VAT, GST or sales
            tax. Check your obligations with the tax authority in your country or a qualified
            accountant before relying on the result.
          </p>
        </Callout>
      </div>
    </Section>

    <FAQList faqs={FREELANCE_RATE_FAQ} />

    <div class="mt-14 max-w-3xl">
      <AdSlot format="end" label="Advertisement" />
    </div>

    <RelatedTools ids={FREELANCE_RATE_RELATED_CALCULATORS} title="Related calculators" />

    <div slot="sidebar">
      <AdSlot format="sidebar" label="Advertisement" />
      {
        otherTools.length > 0 && (
          <nav aria-label="Quick tools" class="mt-6 card p-5">
            <p class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">
              Quick links
            </p>
            <ul class="mt-3 grid gap-2.5 text-sm">
              <li>
                <a href="/calculators/" class="link-draw inline-block text-ink-soft hover:text-ink">
                  All calculators
                </a>
              </li>
              {otherTools.map((tool) => (
                <li>
                  <a href={tool.href} class="link-draw inline-block text-ink-soft hover:text-ink">
                    {tool.name}
                  </a>
                </li>
              ))}
              <li>
                <a href="/about/" class="link-draw inline-block text-ink-soft hover:text-ink">
                  About soloyolo
                </a>
              </li>
            </ul>
          </nav>
        )
      }
    </div>
  </ToolPageLayout>
</BaseLayout>
