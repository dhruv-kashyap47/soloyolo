---
import Decimal from 'decimal.js';

import MarkupMarginCalculator from '@/components/calculators/MarkupMarginCalculator';
import AdSlot from '@/components/ads/AdSlot.astro';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ToolPageLayout from '@/components/layout/ToolPageLayout.astro';
import Callout from '@/components/ui/Callout.astro';
import FAQList from '@/components/ui/FAQList.astro';
import RelatedTools from '@/components/ui/RelatedTools.astro';
import Section from '@/components/ui/Section.astro';
import {
  MARKUP_MARGIN_ASSUMPTIONS,
  MARKUP_MARGIN_COMPARISON,
  MARKUP_MARGIN_EXAMPLES,
  MARKUP_MARGIN_FAQ,
  MARKUP_MARGIN_META,
  MARKUP_MARGIN_RELATED_CALCULATORS,
  toMarkupMarginInput,
} from '@/data/calculators/markup-margin';
import { validateMarkupMarginContent } from '@/data/calculators/markup-margin.schema';
import { calculateMarkupMargin } from '@/lib/calculators/markupMargin';
import { formatCurrency } from '@/lib/formatting/currency';
import { formatNumber, formatPercent } from '@/lib/formatting/number';
import { liveTools } from '@/lib/tools';

validateMarkupMarginContent();

const meta = MARKUP_MARGIN_META;
const siteUrl = Astro.site ?? new URL('https://ledgerly.example.com');
const otherTools = liveTools('calculator').filter((tool) => tool.href !== meta.path);

// Worked examples and the comparison table are computed with the real
// calculator at build time, so no printed percentage can drift from the tool.
const examples = MARKUP_MARGIN_EXAMPLES.map((example) => {
  const outcome = calculateMarkupMargin(toMarkupMarginInput(example.inputs));

  if (!outcome.ok) {
    throw new Error(`Worked example "${example.id}" does not calculate: ${outcome.message}`);
  }

  return { ...example, value: outcome.value };
});

const comparison = MARKUP_MARGIN_COMPARISON.map((markup) => {
  const outcome = calculateMarkupMargin({
    mode: 'price',
    cost: new Decimal(100),
    markupPercent: new Decimal(markup),
  });

  if (!outcome.ok || outcome.value.margin === null) {
    throw new Error(`Comparison row for ${markup}% markup does not calculate.`);
  }

  return { markup, margin: outcome.value.margin, price: outcome.value.price };
});

const percentOrDash = (value: Decimal | null) => (value === null ? '—' : formatPercent(value));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: meta.title,
    description: meta.description,
    url: new URL(meta.path, siteUrl).href,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    isPartOf: {
      '@type': 'WebSite',
      name: 'SoloYolo',
      url: siteUrl.href,
    },
  },
];
---

<BaseLayout
  title={`${meta.title} for freelancers and small businesses`}
  description={meta.description}
  path={meta.path}
  jsonLd={jsonLd}
>
  <ToolPageLayout
    eyebrow={meta.eyebrow}
    title={meta.title}
    description={meta.intro}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Calculators', href: '/calculators/' },
      { label: 'Markup vs Margin Calculator' },
    ]}
    sidebar
  >
    <div id="calculator" class="scroll-mt-24">
      <MarkupMarginCalculator client:load />
    </div>

    <!-- Ad: top unit, after the tool, in natural reading flow -->
    <div class="mt-12 max-w-3xl sm:mt-14">
      <AdSlot format="top" label="Advertisement" />
    </div>

    <Section id="how-it-works" title="How it works">
      <div class="prose-ledger">
        <p>
          Cost, price, markup and margin are four descriptions of one sale. Any two of them fix the
          other two, which is why this calculator asks for a pair and works out the rest instead of
          letting you enter numbers that contradict each other.
        </p>
        <p>
          <strong>Markup</strong> is the profit you add on top of cost, expressed as a percentage of
          that cost. <strong>Margin</strong> is the profit left in the price, expressed as a
          percentage of the price. The profit is identical; only the denominator changes. That single
          change is enough to make a 100% markup a 50% margin.
        </p>
        <p>
          Choose what you want to work out at the top of the tool. <strong>Margin</strong> and{' '}
          <strong>markup</strong> take a cost and a price. <strong>Price</strong> takes a cost and the
          markup you want to apply. <strong>Cost</strong> takes a price and the margin you need to
          keep, and returns your spending ceiling for the job.
        </p>
        <p>
          A price below cost is allowed in the margin and markup modes and produces a negative
          result: clearance stock, a loss-leading project or a fixed-price job that overran. Seeing
          that number is the point.
        </p>
      </div>
    </Section>

    <!-- Ad: in-article unit between content sections -->
    <div class="mt-12 max-w-3xl sm:mt-14">
      <AdSlot format="inarticle" label="Advertisement" />
    </div>

    <Section id="formula" title="The formula">
      <div class="prose-ledger">
        <p>Four values, two identities:</p>
      </div>
      <pre
        class="formula mt-4 max-w-3xl"
        tabindex="0"
        role="region"
        aria-label="Markup and margin formula"
      ><code>profit = price − cost
markup = profit ÷ cost
margin = profit ÷ price

price  = cost × (1 + markup)
cost   = price × (1 − margin)</code></pre>
      <div class="prose-ledger mt-4">
        <p>
          Converting one percentage into the other needs no price at all:{' '}
          <code>margin = markup ÷ (1 + markup)</code> and{' '}
          <code>markup = margin ÷ (1 − margin)</code>. In the default example a $2,500 cost sold for
          $5,000 gives a $2,500 profit: <strong>100% markup</strong> and <strong>50% margin</strong>.
        </p>
        <p>
          Percentages are shown to one decimal place. The exact figures stay at full precision and
          are rounded half-up only for display, so a value that sits on a boundary is never quietly
          rounded down.
        </p>
      </div>
    </Section>

    <Section id="comparison" title="Markup is not margin">
      <div class="prose-ledger">
        <p>
          The two numbers pull apart quickly. On a cost of 100, here is what each markup really
          returns. The right-hand column is the price you would charge, and the middle one is what
          you would actually keep.
        </p>
      </div>

      <div class="mt-5 max-w-2xl">
        <table class="w-full text-sm">
          <caption class="sr-only">
            Markup percentages, the equivalent margin and the resulting price on a cost of 100
          </caption>
          <thead>
            <tr class="border-line border-b text-left">
              <th scope="col" class="text-muted pb-2 text-xs font-semibold tracking-wide uppercase">
                Markup
              </th>
              <th scope="col" class="text-muted pb-2 text-xs font-semibold tracking-wide uppercase">
                Margin
              </th>
              <th scope="col" class="text-muted pb-2 text-xs font-semibold tracking-wide uppercase">
                Price on a cost of 100
              </th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr class="border-line border-b last:border-b-0">
                <th scope="row" class="py-2.5 pr-4 text-left font-medium tabular-nums">
                  {row.markup}%
                </th>
                <td class="text-accent-strong py-2.5 pr-4 font-semibold tabular-nums">
                  {formatPercent(row.margin)}
                </td>
                <td class="text-ink-soft py-2.5 tabular-nums">
                  {formatNumber(row.price, { decimals: 2 })}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-8 max-w-3xl">
        <Callout variant="warn" title="The expensive mistake">
          <p>
            Quoting a 50% markup as though it were a 50% margin overstates the profit by a third. On
            a 100 cost you would price at 150 thinking you keep half, when you actually keep a third.
            Multiply those points across a year of work and the shortfall is the difference between a
            good business and a busy one.
          </p>
        </Callout>
      </div>
    </Section>

    <Section id="worked-examples" title="Worked examples" width="wide">
      <div class="grid gap-4">
        {examples.map((example) => (
          <article class="card p-5 sm:p-6">
            <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
              <div>
                <h3 class="text-base font-semibold text-ink">{example.name}</h3>
                <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-soft">
                  {example.scenario}
                </p>
                <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink-soft">
                  <strong class="font-semibold text-ink">What this shows:</strong>{' '}
                  {example.takeaway}
                </p>
              </div>

              <dl class="divide-y divide-line rounded-lg border border-line bg-canvas/60 px-4">
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Cost</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(example.value.costRounded, example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Price</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(example.value.priceRounded, example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Profit</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {formatCurrency(example.value.profitRounded, example.currency)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-xs text-muted">Markup</dt>
                  <dd class="text-sm font-medium tabular-nums">
                    {percentOrDash(example.value.markup)}
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-xs font-semibold text-accent-strong">Margin</dt>
                  <dd class="text-base font-semibold tabular-nums text-accent-strong">
                    {percentOrDash(example.value.margin)}
                  </dd>
                </div>
              </dl>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-8">
        <a
          href="#calculator"
          class="link-draw inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-accent-strong"
        >
          Work out your own numbers
          <span aria-hidden="true">&uarr;</span>
        </a>
      </p>
    </Section>

    <Section id="assumptions" title="Assumptions and limitations">
      <div class="prose-ledger">
        <ul>
          {MARKUP_MARGIN_ASSUMPTIONS.map((assumption) => (
            <li>{assumption}</li>
          ))}
        </ul>
      </div>

      <div class="mt-6 max-w-3xl">
        <Callout variant="warn" title="Not tax or financial advice">
          <p>
            This calculator is an informational planning tool. It does not know your tax residency,
            entity structure or deductions, and it does not calculate income tax, VAT, GST or sales
            tax. Check your obligations with the tax authority in your country or a qualified
            accountant before relying on the result.
          </p>
        </Callout>
      </div>
    </Section>

    <FAQList faqs={MARKUP_MARGIN_FAQ} />

    <!-- Ad: end-of-content unit -->
    <div class="mt-14 max-w-3xl">
      <AdSlot format="end" label="Advertisement" />
    </div>

    <RelatedTools ids={MARKUP_MARGIN_RELATED_CALCULATORS} title="Related calculators" />

    <div slot="sidebar">
      <AdSlot format="sidebar" label="Advertisement" />
      {
        otherTools.length > 0 && (
          <nav aria-label="Quick tools" class="mt-6 card p-5">
            <p class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">
              Quick links
            </p>
            <ul class="mt-3 grid gap-2.5 text-sm">
              <li>
                <a href="/calculators/" class="link-draw inline-block text-ink-soft hover:text-ink">
                  All calculators
                </a>
              </li>
              {otherTools.map((tool) => (
                <li>
                  <a href={tool.href} class="link-draw inline-block text-ink-soft hover:text-ink">
                    {tool.name}
                  </a>
                </li>
              ))}
              <li>
                <a href="/about/" class="link-draw inline-block text-ink-soft hover:text-ink">
                  About SoloYolo
                </a>
              </li>
            </ul>
          </nav>
        )
      }
    </div>
  </ToolPageLayout>
</BaseLayout>
