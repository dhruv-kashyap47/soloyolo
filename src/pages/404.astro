---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { liveTools } from '@/lib/tools';

const calculators = liveTools();
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for does not exist. Browse the free business calculators instead."
  path="/404/"
  noindex
>
  <div class="container-page py-20 sm:py-28">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 max-w-2xl text-[clamp(2.4rem,1.6rem+4vw,3.75rem)] font-medium leading-[1.03] tracking-[-0.03em]">
      That page isn’t here
    </h1>
    <p class="mt-4 max-w-xl text-ink-soft">
      The link may be out of date. The calculators are all still in one place.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/calculators/" class="btn btn-primary">
        Browse calculators
      </a>
      <a href="/" class="btn btn-secondary">
        Go to the homepage
      </a>
    </div>

    <ul class="mt-12 max-w-xl border-t border-line pt-6 grid gap-2.5">
      {calculators.map((tool) => (
        <li>
          <a href={tool.href} class="link-draw inline-block text-sm font-medium text-ink-soft hover:text-ink">
            {tool.name} →
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
