---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { SITE } from '@/config/site';
import {
  CROSS_BORDER_NOTES,
  EINVOICING_ROWS,
  RECORDS_FAQS,
  RECORDS_SOURCES,
  RECORDS_VERIFIED_ON,
  RETENTION_ROWS,
  SOURCE_SHORT_LABELS,
} from '@/data/records';
import { formatDate } from '@/lib/formatting/date';

const siteUrl = Astro.site ?? new URL(SITE.url);
const path = '/resources/e-invoicing-and-record-keeping/';
const url = new URL(path, siteUrl).href;

const title = 'E-invoicing deadlines and record keeping by country';
const description =
  'When each of the eight markets requires structured e-invoices, what a PDF is still worth, and how long invoices and records must be kept, each checked against the authority that owns the rule.';

const sourceById = new Map(RECORDS_SOURCES.map((source) => [source.id, source]));
const citedIds = new Set<string>();

function sourcesFor(ids: readonly string[]) {
  return ids.flatMap((id) => {
    citedIds.add(id);
    const source = sourceById.get(id);
    return source ? [source] : [];
  });
}

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url,
    dateModified: RECORDS_VERIFIED_ON,
    isPartOf: {
      '@type': 'WebSite',
      name: SITE.name,
      url: siteUrl.href,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl.href },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: new URL('/resources/', siteUrl).href },
      { '@type': 'ListItem', position: 3, name: 'E-invoicing and records', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: RECORDS_FAQS.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];

const checkedOn = formatDate(RECORDS_VERIFIED_ON);
const statusTone: Record<(typeof EINVOICING_ROWS)[number]['status'], string> = {
  'No mandate': 'text-muted',
  'Live now': 'text-accent-strong',
  'Dated mandate': 'text-ink',
  'Already required': 'text-ink',
};
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Resources', href: '/resources/' },
        { label: 'E-invoicing and records' },
      ]}
    />

    <article class="max-w-3xl pt-8 pb-2 sm:pt-12">
      <p class="eyebrow">Resources</p>
      <h1 class="mt-3 text-[clamp(2.1rem,1.4rem+3.4vw,3.4rem)] font-medium leading-[1.05] tracking-[-0.03em]">
        When an invoice stops being a PDF
      </h1>
      <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg">
        Eight markets, eight answers. Germany, India and the UAE already treat the structured record as
        the invoice. The UK turns the corner on 1 April 2029. The others still accept a readable
        invoice, and the retention clock behind all of them runs from five to ten years.
      </p>
      <p class="mt-3 text-sm leading-relaxed text-ink-soft">
        This page only states what an authority publishes, with the link beside it. It does not model
        income tax, social contributions or filing dates, and it is not tax advice.
      </p>
    </article>

    <section class="mt-10 sm:mt-12" aria-labelledby="timeline-heading">
      <h2
        id="timeline-heading"
        class="text-[clamp(1.6rem,1.3rem+1.5vw,2rem)] font-medium leading-tight tracking-[-0.02em]"
      >
        E-invoicing, market by market
      </h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[46rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-line border-b">
              <th scope="col" class="py-2 pr-4 font-semibold">Market</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Status</th>
              <th scope="col" class="py-2 pr-4 font-semibold">What changes, and when</th>
              <th scope="col" class="py-2 font-semibold">Who it covers</th>
            </tr>
          </thead>
          <tbody>
            {EINVOICING_ROWS.map((row) => (
              <tr class="border-line border-b align-top">
                <th scope="row" class="py-4 pr-4 font-medium">
                  {row.country}
                </th>
                <td class={`py-4 pr-4 whitespace-nowrap ${statusTone[row.status]}`}>{row.status}</td>
                <td class="py-4 pr-4">
                  <span class="block font-medium">{row.next}</span>
                  <span class="text-ink-soft mt-1 block text-xs leading-relaxed">{row.note}</span>
                  <span class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
                    {sourcesFor(row.sourceIds).map((source) => (
                      <a
                        class="text-accent-strong text-xs font-semibold underline decoration-1 underline-offset-2"
                        href={source.url}
                        rel="noopener"
                      >
                        {SOURCE_SHORT_LABELS[source.id] ?? source.label}
                      </a>
                    ))}
                  </span>
                </td>
                <td class="text-ink-soft py-4 text-xs leading-relaxed">{row.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-14 sm:mt-16" aria-labelledby="retention-heading">
      <h2
        id="retention-heading"
        class="text-[clamp(1.6rem,1.3rem+1.5vw,2rem)] font-medium leading-tight tracking-[-0.02em]"
      >
        How long to keep the invoice
      </h2>
      <p class="text-ink-soft mt-3 max-w-2xl text-sm leading-relaxed">
        The period usually starts when the year closes, not when the invoice is sent. Where a market
        has two clocks, the longer one decides how long the paperwork stays in the drawer.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-line border-b">
              <th scope="col" class="py-2 pr-4 font-semibold">Market</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Period</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Clock starts</th>
              <th scope="col" class="py-2 font-semibold">Source</th>
            </tr>
          </thead>
          <tbody>
            {RETENTION_ROWS.map((row) => (
              <tr class="border-line border-b align-top">
                <th scope="row" class="py-4 pr-4 font-medium">
                  {row.country}
                </th>
                <td class="py-4 pr-4">
                  <span class="block font-medium">{row.period}</span>
                  <span class="text-ink-soft mt-1 block text-xs leading-relaxed">{row.note}</span>
                </td>
                <td class="text-ink-soft py-4 pr-4 text-xs leading-relaxed">{row.from}</td>
                <td class="py-4">
                  {sourcesFor(row.sourceIds).map((source) => (
                    <a
                      class="text-accent-strong block text-xs font-semibold underline decoration-1 underline-offset-2"
                      href={source.url}
                      rel="noopener"
                    >
                      {SOURCE_SHORT_LABELS[source.id] ?? source.label}
                    </a>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-muted mt-4 max-w-2xl text-xs leading-relaxed">
        India is not in this table. The CGST and income tax retention rules were not confirmed against
        a primary source, so no figure is published for them.
      </p>
    </section>

    <section class="mt-14 sm:mt-16" aria-labelledby="traps-heading">
      <h2
        id="traps-heading"
        class="text-[clamp(1.6rem,1.3rem+1.5vw,2rem)] font-medium leading-tight tracking-[-0.02em]"
      >
        Three things that catch people out
      </h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">
        {CROSS_BORDER_NOTES.map((note) => (
          <li class="border-line bg-surface/60 rounded-lg border p-5">
            <p class="font-medium">{note.title}</p>
            <p class="text-ink-soft mt-2 text-sm leading-relaxed">{note.body}</p>
            <span class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
              {sourcesFor(note.sourceIds).map((source) => (
                <a
                  class="text-accent-strong text-xs font-semibold underline decoration-1 underline-offset-2"
                  href={source.url}
                  rel="noopener"
                >
                  {SOURCE_SHORT_LABELS[source.id] ?? source.label}
                </a>
              ))}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-14 sm:mt-16" aria-labelledby="faq-heading">
      <h2
        id="faq-heading"
        class="text-[clamp(1.6rem,1.3rem+1.5vw,2rem)] font-medium leading-tight tracking-[-0.02em]"
      >
        Questions
      </h2>
      <dl class="mt-6 grid gap-6">
        {RECORDS_FAQS.map((faq) => (
          <div class="border-line border-t pt-5">
            <dt class="font-medium">{faq.question}</dt>
            <dd class="text-ink-soft mt-2 text-sm leading-relaxed">{faq.answer}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section
      class="border-line mt-14 border-t pt-6 sm:mt-16"
      id="sources"
      aria-labelledby="sources-heading"
    >
      <h2 id="sources-heading" class="text-lg font-medium">
        Official sources
      </h2>
      <p class="text-ink-soft mt-2 max-w-2xl text-sm leading-relaxed">
        Every claim above was checked against these pages on {checkedOn}. Where a rule changes, the
        date on this page changes with it.
      </p>
      <ul class="mt-5 grid gap-3">
        {RECORDS_SOURCES.filter((source) => citedIds.has(source.id)).map((source) => (
          <li class="text-sm leading-relaxed">
            <a
              class="text-accent-strong font-semibold underline decoration-1 underline-offset-2"
              href={source.url}
              rel="noopener"
            >
              {source.label}
            </a>
            <span class="text-ink-soft block text-xs">{source.note}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="border-line mt-12 border-t pt-6" aria-labelledby="next-heading">
      <h2 id="next-heading" class="text-lg font-medium">
        Put it on a document
      </h2>
      <p class="text-ink-soft mt-2 max-w-2xl text-sm leading-relaxed">
        The invoice generator prints the readable document for each market, with the tax invoice
        fields that market asks for. Germany, India and the UAE forms include the cross-border wording
        that a reverse-charge or export invoice needs. A printed invoice is not an e-invoice, and the
        pages say so.
      </p>
      <div class="mt-4 flex flex-wrap gap-3 text-sm font-semibold">
        <a class="btn btn-secondary" href="/generators/invoice-generator/">Invoice generator</a>
        <a class="btn btn-secondary" href="/countries/">Compare the eight markets</a>
        <a class="btn btn-secondary" href="/resources/">All resources</a>
      </div>
    </section>
  </div>
</BaseLayout>
