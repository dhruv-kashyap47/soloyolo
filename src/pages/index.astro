---
import Decimal from 'decimal.js';

import BaseLayout from '@/components/layout/BaseLayout.astro';
import ToolCard from '@/components/ui/ToolCard.astro';
import { SITE } from '@/config/site';
import { calculateHourlyRate } from '@/lib/calculators/hourlyRate';
import { formatCurrency } from '@/lib/formatting/currency';
import { formatNumber } from '@/lib/formatting/number';
import { liveTools } from '@/lib/tools';

const calculators = liveTools('calculator');
const siteUrl = Astro.site ?? new URL('https://ledgerly.example.com');

const example = calculateHourlyRate({
  targetIncome: new Decimal('80000'),
  annualExpenses: new Decimal('12000'),
  workingWeeks: new Decimal('48'),
  billableHoursPerWeek: new Decimal('25'),
});

const exampleRate = example.ok ? formatCurrency(example.value.hourlyRateRounded, 'USD') : '';
const exampleRevenue = example.ok ? formatCurrency(example.value.requiredAnnualRevenue, 'USD') : '';
const exampleHours = example.ok ? formatNumber(example.value.billableHoursPerYear) : '';
const exampleCopy = `Target income of $80,000 plus $12,000 of business costs, billed across ${exampleHours} billable hours.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: siteUrl.href,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: siteUrl.href,
    inLanguage: 'en',
  },
];
---

<BaseLayout
  title="Ledgerly — Business tools for independent professionals"
  description={SITE.description}
  path="/"
  jsonLd={jsonLd}
>
  <section class="container-page pt-12 pb-16 sm:pt-20 sm:pb-20">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-16">
      <div>
        <p class="eyebrow">For freelancers, consultants &amp; small studios</p>
        <h1 class="mt-4 max-w-xl font-serif text-[2.6rem] leading-[1.03] font-semibold tracking-tight sm:text-6xl">
          Price your work with confidence.
        </h1>
        <p class="mt-6 max-w-xl text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg">
          Free, privacy-first calculators and document tools that help independent professionals set
          sustainable rates, check margins, and send professional invoices. Everything runs in your
          browser — no account, no uploads.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/calculators/hourly-rate-calculator/" class="btn btn-primary">
            Calculate your hourly rate
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M3 8h9.5M9 4.5 12.5 8 9 11.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </a>
          <a href="/calculators/" class="btn btn-secondary">
            Browse all tools
          </a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
          <li class="flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="m3 8.5 3.2 3L13 4.5"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            No sign-up
          </li>
          <li class="flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="m3 8.5 3.2 3L13 4.5"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            Nothing leaves your device
          </li>
          <li class="flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="m3 8.5 3.2 3L13 4.5"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            Exact decimal math
          </li>
        </ul>
      </div>

      <div class="lg:justify-self-end">
        <div class="card card-raised w-full max-w-md p-6">
          <div class="flex items-center justify-between gap-3">
            <p class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">
              Worked example
            </p>
            <span class="rounded-full border border-accent-line bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent-strong">
              USD
            </span>
          </div>

          <p class="mt-5 flex flex-wrap items-baseline gap-x-2">
            <span class="font-serif text-5xl leading-none font-semibold tracking-tight text-accent-strong">
              {exampleRate}
            </span>
            <span class="text-sm font-medium text-ink-soft">per hour</span>
          </p>

          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{exampleCopy}</p>

          <dl class="mt-5 grid grid-cols-3 gap-3 border-t border-line pt-4">
            <div>
              <dt class="text-[0.6875rem] tracking-wide text-muted uppercase">Weeks</dt>
              <dd class="mt-1 text-sm font-semibold tabular-nums">48</dd>
            </div>
            <div>
              <dt class="text-[0.6875rem] tracking-wide text-muted uppercase">Billable hrs/wk</dt>
              <dd class="mt-1 text-sm font-semibold tabular-nums">25</dd>
            </div>
            <div>
              <dt class="text-[0.6875rem] tracking-wide text-muted uppercase">Revenue needed</dt>
              <dd class="mt-1 text-sm font-semibold tabular-nums">{exampleRevenue}</dd>
            </div>
          </dl>

          <a
            href="/calculators/hourly-rate-calculator/"
            class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-accent underline-offset-4 hover:underline"
          >
            See the full breakdown
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-surface py-14 sm:py-16" aria-labelledby="tools-heading">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Free tools</p>
          <h2 id="tools-heading" class="mt-3 font-serif text-3xl font-semibold tracking-tight">
            Start with the numbers that matter
          </h2>
        </div>
        <a
          href="/calculators/"
          class="text-sm font-semibold text-accent underline-offset-4 hover:underline"
        >
          All calculators →
        </a>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center">
        <ul class="grid gap-4">
          {calculators.map((tool) => (
            <li>
              <ToolCard tool={tool} />
            </li>
          ))}
        </ul>

        <div class="rounded-xl border border-line bg-canvas/70 p-6">
          <p class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">
            In development
          </p>
          <ul class="mt-4 grid gap-2.5 text-sm text-ink-soft sm:grid-cols-2">
            {[
              'Freelance rate',
              'Project profit',
              'Markup vs margin',
              'Payment fees',
              'VAT / GST / sales tax',
              'Retainer pricing',
              'Break-even',
            ].map((name) => (
              <li class="flex items-center gap-2.5">
                <span class="h-1 w-1 shrink-0 rounded-full bg-line-strong" aria-hidden="true" />
                {name}
              </li>
            ))}
          </ul>
          <p class="mt-5 border-t border-line pt-4 text-xs leading-relaxed text-muted">
            Invoice, quote, receipt and reminder generators follow next. Every tool ships only after
            its maths is covered by tests.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20" aria-labelledby="principles-heading">
    <div class="max-w-2xl">
      <p class="eyebrow">Built differently</p>
      <h2 id="principles-heading" class="mt-3 font-serif text-3xl font-semibold tracking-tight">
        A business toolkit you can actually trust
      </h2>
    </div>

    <ul class="mt-8 grid gap-6 sm:grid-cols-3">
      <li class="border-t border-line-strong pt-4">
        <h3 class="text-[0.9375rem] font-semibold">Private by design</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          Invoice details, client names and financial figures never leave your browser. There is no
          account to create and no server to trust with your data.
        </p>
      </li>
      <li class="border-t border-line-strong pt-4">
        <h3 class="text-[0.9375rem] font-semibold">Exact, not approximate</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          Every calculation uses decimal arithmetic instead of floating point, and each formula is
          covered by automated tests — including rounding, zero and extreme values.
        </p>
      </li>
      <li class="border-t border-line-strong pt-4">
        <h3 class="text-[0.9375rem] font-semibold">No dark patterns</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          No paywalled results, no forced email capture, no fake urgency. The tool is fully usable
          on the first screen, including on a phone.
        </p>
      </li>
    </ul>
  </section>

  <section class="container-page pb-4">
    <div class="rounded-2xl bg-footer px-6 py-10 text-ink-invert sm:px-10 sm:py-12">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-xl">
          <h2 class="font-serif text-2xl font-semibold tracking-tight sm:text-3xl">
            Find the rate that funds your year
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-[#b9bdb8]">
            Two minutes with real numbers beats another guess. Free, private, and no account
            required.
          </p>
        </div>
        <a
          href="/calculators/hourly-rate-calculator/"
          class="btn shrink-0 bg-ink-invert text-footer hover:bg-white"
        >
          Open the calculator
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
