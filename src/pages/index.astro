---
import Decimal from 'decimal.js';

import AdSlot from '@/components/ads/AdSlot.astro';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ToolCard from '@/components/ui/ToolCard.astro';
import { SITE } from '@/config/site';
import { calculateHourlyRate, quoteWork } from '@/lib/calculators/hourlyRate';
import { formatCurrency } from '@/lib/formatting/currency';
import { formatNumber } from '@/lib/formatting/number';
import { liveTools } from '@/lib/tools';

const calculators = liveTools('calculator');
const siteUrl = Astro.site ?? new URL('https://ledgerly.example.com');

const example = calculateHourlyRate({
  targetIncome: new Decimal('80000'),
  annualExpenses: new Decimal('12000'),
  workingWeeks: new Decimal('48'),
  billableHoursPerWeek: new Decimal('25'),
});

const exampleRate = example.ok ? formatCurrency(example.value.hourlyRateRounded, 'USD') : '';
const exampleRevenue = example.ok ? formatCurrency(example.value.requiredAnnualRevenue, 'USD') : '';
const exampleHours = example.ok ? formatNumber(example.value.billableHoursPerYear) : '';
const exampleCopy = `Target income of $80,000 plus $12,000 of business costs, billed across ${exampleHours} billable hours.`;
const exampleQuote = example.ok
  ? formatCurrency(quoteWork(example.value.hourlyRateRounded, 40), 'USD')
  : '';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: siteUrl.href,
    description: SITE.description,
    logo: new URL('/apple-touch-icon.png', siteUrl).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: siteUrl.href,
    inLanguage: 'en',
  },
];

/* One quiet ground per band: a faint radial accent set on the section itself,
   so the content layers stay clean and the section reads as one ground. */
const glow = (x: string, y: string, c: string) =>
  `radial-gradient(42rem 28rem at ${x} ${y}, ${c}, transparent 70%)`;
---

<BaseLayout
  title="SoloYolo: business tools for independent professionals"
  description={SITE.description}
  path="/"
  jsonLd={jsonLd}
>
  <!-- S0: hero, the one section on the first screen -->
  <section
    class="hero-screen"
    style={`background-image: ${glow('82%', '18%', 'rgb(43 127 255 / 0.14)')}`}
  >
    <div class="wrap">
      <div class="hero-text grid grid-cols-12 gap-6 sm:my-auto lg:items-start">
        <div class="col-span-12 lg:col-span-5">
          <p class="eyebrow" data-enter style="--enter-i: 0">For freelancers, consultants &amp; small studios</p>
          <h1
            class="mt-3 max-w-xl text-[clamp(2.25rem,1.4rem+3.4vw,4.25rem)] font-medium leading-[1.04] tracking-[-0.04em]"
            data-enter
            style="--enter-i: 1"
          >
            Free business tools to price your work.
          </h1>
          <p
            class="mt-5 max-w-lg text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg"
            data-enter
            style="--enter-i: 2"
          >
            Privacy-first calculators that help independent professionals set sustainable rates,
            check margins and price projects. Everything runs in your browser: no account, no
            uploads.
          </p>


          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-enter style="--enter-i: 3">
            <a href="/calculators/hourly-rate-calculator/" class="btn btn-primary">
              Calculate your hourly rate
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M3 8h9.5M9 4.5 12.5 8 9 11.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
            <a href="/calculators/" class="btn btn-secondary">
              Browse all tools
            </a>
          </div>

          <!-- the worked example in a phone-sized card: the same numbers as the desktop panel -->
          <div class="card card-raised mt-6 p-5 lg:hidden" data-enter style="--enter-i: 3">
            <div class="flex items-baseline justify-between gap-3">
              <p class="flex items-baseline gap-2">
                <span class="text-2xl font-medium leading-none tracking-[-0.03em] text-accent-strong">
                  {exampleRate}
                </span>
                <span class="text-xs font-medium text-ink-soft">per hour</span>
              </p>
              <span class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">
                Worked example
              </span>
            </div>
            <p class="mt-2 text-xs leading-relaxed text-ink-soft">
              An $80,000 income target plus $12,000 of costs, billed across {exampleHours} hours.
            </p>
          </div>
        </div>

        <div
          class="card card-raised col-span-12 flex flex-col p-6 max-lg:hidden lg:col-span-6 lg:col-start-7"
          data-enter
          style="--enter-i: 2"
        >
          <div class="flex items-center justify-between gap-3">
            <p class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">
              Worked example
            </p>
            <span class="rounded-full border border-accent-line bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent-strong">
              USD
            </span>
          </div>

          <p class="mt-5 flex flex-wrap items-baseline gap-x-2">
            <span class="text-4xl font-medium leading-none tracking-[-0.03em] text-accent-strong sm:text-[2.5rem]">
              {exampleRate}
            </span>
            <span class="text-sm font-medium text-ink-soft">per hour</span>
          </p>

          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{exampleCopy}</p>

          <dl class="mt-5 grid grid-cols-3 gap-3 border-t border-line pt-4">
            <div>
              <dt class="text-[0.6875rem] tracking-wide text-muted uppercase">Weeks</dt>
              <dd class="mt-1 text-sm font-semibold tabular-nums">48</dd>
            </div>
            <div>
              <dt class="text-[0.6875rem] tracking-wide text-muted uppercase">Billable hrs/wk</dt>
              <dd class="mt-1 text-sm font-semibold tabular-nums">25</dd>
            </div>
            <div>
              <dt class="text-[0.6875rem] tracking-wide text-muted uppercase">Revenue needed</dt>
              <dd class="mt-1 text-sm font-semibold tabular-nums">{exampleRevenue}</dd>
            </div>
          </dl>

          <a
            href="/calculators/hourly-rate-calculator/"
            class="link-draw mt-4 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-accent-strong"
          >
            See the full breakdown
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <ul
        class="mt-6 flex flex-col gap-x-6 gap-y-2 text-sm text-muted sm:mt-0 sm:flex-row sm:flex-wrap"
        data-enter
        style="--enter-i: 4"
      >
        <li class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="m3 8.5 3.2 3L13 4.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          No sign-up
        </li>
        <li class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="m3 8.5 3.2 3L13 4.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Nothing leaves your device
        </li>
        <li class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="m3 8.5 3.2 3L13 4.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Exact decimal math
        </li>
      </ul>
    </div>
  </section>

  <!-- S1: the tools, with the top ad unit as the last block -->
  <section
    class="screen"
    aria-labelledby="tools-heading"
    style={`background-image: ${glow('8%', '30%', 'rgb(43 127 255 / 0.10)')}`}
  >
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow">Free tools</p>
          <h2 id="tools-heading" class="mt-3 text-[clamp(1.75rem,1.4rem+2.2vw,2.625rem)] font-medium tracking-[-0.03em]">
            Pricing starts with your hourly rate
          </h2>
        </div>
        <a
          href="/calculators/"
          class="link-draw inline-flex min-h-11 items-center text-sm font-semibold text-accent-strong"
        >
          All calculators →
        </a>
      </div>

      <div class="mt-6 grid gap-6 sm:mt-8 lg:grid-cols-2">
        {calculators.map((tool) => (
          <ToolCard tool={tool} />
        ))}

        <a href="/calculators/" class="card card-hover group flex h-full flex-col p-6">
          <span class="flex items-center justify-between gap-3">
            <span class="text-[0.6875rem] font-semibold tracking-[0.1em] text-muted uppercase">
              In development
            </span>
            <span
              aria-hidden="true"
              class="text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-accent-strong"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path
                  d="M3 8h9.5M9 4.5 12.5 8 9 11.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </span>
          <span class="mt-3 text-lg font-semibold tracking-tight text-ink group-hover:text-accent-strong">
            Generators on the way
          </span>
          <span class="mt-2 text-sm leading-relaxed text-ink-soft">
            The calculator set is complete. Next: invoice, quote and receipt generators, and payment
            reminders.
          </span>
          <ul class="mt-4 hidden flex-wrap gap-1.5 sm:flex">
            {['Invoice generator', 'Quote generator', 'Receipt generator', 'Payment reminders'].map((name) => (
              <li class="rounded-full border border-line px-3 py-1 text-xs text-muted">
                {name}
              </li>
            ))}
          </ul>
        </a>
      </div>

      <div class="pt-6 sm:pt-8">
        <AdSlot format="top" label="Advertisement" />
      </div>
    </div>
  </section>

  <!-- S2: the dealt moment, two screens of pinned scroll through one calculation -->
  <section
    class="screen"
    data-moment="pinned-chapters"
    style="--h: 2"
    aria-labelledby="how-heading"
  >
    <div class="wrap mo-pc__grid">
      <div class="mo-pc__text">
        <p class="eyebrow">Under the hood</p>
        <h2
          id="how-heading"
          class="mt-3 text-[clamp(1.75rem,1.4rem+2.2vw,2.625rem)] font-medium tracking-[-0.03em]"
        >
          How a SoloYolo calculation runs
        </h2>

        <ol class="mo-pc__steps">
          <li class="mo-pc__step">
            <h3 class="text-[0.9375rem] font-semibold">Step one: enter your numbers</h3>
            <p class="text-sm leading-relaxed text-ink-soft">
              Income target, business costs, working weeks and billable hours. Nothing you type
              leaves your browser.
            </p>
            <figure class="mo-pc__visual" data-ui>
              <div class="mo-ui">
                <p class="mo-ui__head"><span>Hourly rate calculator</span><span class="mo-ui__tag">USD</span></p>
                <div class="mo-ui__rows">
                  <p class="mo-ui__row"><span>Income target</span><b>$80,000</b></p>
                  <p class="mo-ui__row"><span>Business costs</span><b>$12,000</b></p>
                  <p class="mo-ui__row"><span>Working weeks</span><b>48</b></p>
                  <p class="mo-ui__row"><span>Billable hours a week</span><b>25</b></p>
                </div>
                <p class="mo-ui__foot">Runs entirely in your browser</p>
              </div>
            </figure>
          </li>
          <li class="mo-pc__step">
            <h3 class="text-[0.9375rem] font-semibold">Step two: see the maths</h3>
            <p class="text-sm leading-relaxed text-ink-soft">
              The rate covers your costs first, then pays the income you asked for, down to the
              cent.
            </p>
            <figure class="mo-pc__visual" data-ui>
              <div class="mo-ui">
                <p class="mo-ui__head"><span>Your rate</span><span class="mo-ui__tag">Exact</span></p>
                <p class="mo-ui__rate"><b>{exampleRate}</b><span>per hour</span></p>
                <div class="mo-ui__rows">
                  <p class="mo-ui__row"><span>Billable hours a year</span><b>{exampleHours}</b></p>
                  <p class="mo-ui__row"><span>Revenue needed</span><b>{exampleRevenue}</b></p>
                </div>
                <p class="mo-ui__foot">Decimal arithmetic, tested formulas</p>
              </div>
            </figure>
          </li>
          <li class="mo-pc__step">
            <h3 class="text-[0.9375rem] font-semibold">Step three: price the work</h3>
            <p class="text-sm leading-relaxed text-ink-soft">
              Quote a project at your rate and see the number you would actually take home.
            </p>
            <figure class="mo-pc__visual" data-ui>
              <div class="mo-ui">
                <p class="mo-ui__head"><span>Project quote</span><span class="mo-ui__tag">Draft</span></p>
                <div class="mo-ui__rows">
                  <p class="mo-ui__row"><span>Hours quoted</span><b>40</b></p>
                  <p class="mo-ui__row"><span>Your rate</span><b>{exampleRate}</b></p>
                  <p class="mo-ui__row"><span>Quote total</span><b>{exampleQuote}</b></p>
                </div>
                <p class="mo-ui__foot">No account, no uploads</p>
              </div>
            </figure>
          </li>
        </ol>
      </div>

      <div class="mo-pc__visuals"></div>

      <div class="mo-pc__foot flex-col sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-muted">Every calculation is free and runs in your browser.</p>
        <a
          href="/calculators/hourly-rate-calculator/"
          class="link-draw inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-accent-strong"
        >
          Calculate your hourly rate
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- S3: the close, the promises as plain rows, and the end-of-content ad -->
  <section class="screen statement bg-band" aria-labelledby="close-heading">
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="eyebrow">Ready when you are</p>
        <h2
          id="close-heading"
          class="mt-3 text-[clamp(1.75rem,1.4rem+2.2vw,2.625rem)] font-medium tracking-[-0.03em]"
        >
          Open the business calculators
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft sm:mt-4 sm:text-[1.0625rem]">
          Two minutes with real numbers beats another guess. Free, private, and no account
          required.
        </p>
        <a href="/calculators/hourly-rate-calculator/" class="btn btn-primary mt-6 shrink-0">
          Calculate your hourly rate
        </a>
      </div>

      <ul class="mt-5 grid gap-1.5 text-[0.875rem] leading-snug sm:mt-6 sm:gap-2 sm:text-[0.9375rem] sm:leading-relaxed">
        <li class="flex flex-col gap-0.5 sm:flex-row sm:gap-4">
          <strong class="shrink-0 text-ink sm:w-44">Private by design</strong>
          <span class="text-ink-soft">Nothing you type leaves your browser: no account, no uploads.</span>
        </li>
        <li class="flex flex-col gap-0.5 sm:flex-row sm:gap-4">
          <strong class="shrink-0 text-ink sm:w-44">Exact, not approximate</strong>
          <span class="text-ink-soft">Decimal arithmetic and tested formulas, not floating-point guesses.</span>
        </li>
        <li class="flex flex-col gap-0.5 sm:flex-row sm:gap-4">
          <strong class="shrink-0 text-ink sm:w-44">No dark patterns</strong>
          <span class="text-ink-soft">Every result is free, on the first screen, on every device.</span>
        </li>
      </ul>

      <div class="mt-auto pt-6 sm:pt-8">
        <AdSlot format="end" label="Advertisement" />
      </div>
    </div>
  </section>
</BaseLayout>
