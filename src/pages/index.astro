---
import Decimal from 'decimal.js';

import AdSlot from '@/components/ads/AdSlot.astro';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import DocumentsDemo from '@/components/home/demos/Documents.astro';
import InvoiceCountries from '@/components/home/demos/InvoiceCountries.astro';
import PaymentFeeDemo from '@/components/home/demos/PaymentFee.astro';
import ProjectProfitDemo from '@/components/home/demos/ProjectProfit.astro';
import RatePass from '@/components/home/demos/RatePass.astro';
import ReminderDemo from '@/components/home/demos/Reminder.astro';
import TaxDemo from '@/components/home/demos/Tax.astro';
import ToolDock from '@/components/home/ToolDock.astro';
import TodayDashboard from '@/components/home/TodayDashboard';
import { calculateHourlyRate, quoteWork } from '@/lib/calculators/hourlyRate';
import { calculatePaymentFee } from '@/lib/calculators/paymentFee';
import { calculateProjectProfit } from '@/lib/calculators/projectProfit';
import { calculateTax } from '@/lib/calculators/tax';
import { getCountryConfig } from '@/lib/countries';
import { quoteExample, receiptExample } from '@/data/generators/examples';
import { buildReminder, REMINDER_TONES } from '@/lib/generators/reminder';
import { calculateDocumentTotals } from '@/lib/generators/totals';
import { addDays, formatDateShort, todayIso } from '@/lib/formatting/date';
import { formatCurrency, type CurrencyCode } from '@/lib/formatting/currency';
import { formatNumber } from '@/lib/formatting/number';
import { calculateMarkupMargin } from '@/lib/calculators/markupMargin';

// ---------------------------------------------------------------------------
// Every figure below is produced by the same engine the tool runs. The build
// fails if an example does not calculate, so the home cannot drift.
// ---------------------------------------------------------------------------

const hourly = calculateHourlyRate({
  targetIncome: new Decimal('80000'),
  annualExpenses: new Decimal('12000'),
  workingWeeks: new Decimal('48'),
  billableHoursPerWeek: new Decimal('25'),
});
if (!hourly.ok) throw new Error(`home hourly example failed: ${hourly.code}`);

const rate = hourly.value.hourlyRateRounded;
const rateRaw = rate.toFixed(2);
const quote = quoteWork(rate, 40);
const quoteFormatted = formatCurrency(quote, 'USD');
const requiredRevenue = formatCurrency(hourly.value.requiredAnnualRevenue, 'USD', { decimals: 0 });
const billableHours = formatNumber(hourly.value.billableHoursPerYear.toNumber());

const heroInvoice = calculateDocumentTotals({
  items: [
    {
      id: 'hero-line',
      description: 'Brand identity, 40 hours',
      quantity: 40,
      unitPrice: rate,
      taxPercent: 8.25,
    },
  ],
});
const heroTax = formatCurrency(heroInvoice.taxTotal, 'USD');
const heroTotal = formatCurrency(heroInvoice.total, 'USD');
const heroTotalRaw = heroInvoice.total.toFixed(2);

const projectBase = calculateProjectProfit({
  revenue: new Decimal('6000'),
  labor: new Decimal('1800'),
  contractor: new Decimal('600'),
  software: new Decimal('120'),
  other: new Decimal('80'),
  overhead: new Decimal('700'),
});
if (!projectBase.ok) throw new Error(`home project base failed: ${projectBase.code}`);

const projectWide = calculateProjectProfit({
  revenue: new Decimal('6000'),
  labor: new Decimal('1800'),
  contractor: new Decimal('0'),
  software: new Decimal('120'),
  other: new Decimal('80'),
  overhead: new Decimal('700'),
});
if (!projectWide.ok) throw new Error(`home project wide failed: ${projectWide.code}`);

const paymentBase = calculatePaymentFee({
  amount: new Decimal('1000'),
  percentFee: new Decimal('2.9'),
  fixedFee: new Decimal('0.30'),
});
if (!paymentBase.ok) throw new Error(`home fee base failed: ${paymentBase.code}`);

const paymentWide = calculatePaymentFee({
  amount: new Decimal('1000'),
  percentFee: new Decimal('1.75'),
  fixedFee: new Decimal('0.25'),
});
if (!paymentWide.ok) throw new Error(`home fee wide failed: ${paymentWide.code}`);

const taxUk = calculateTax({
  mode: 'add',
  amount: new Decimal('1000'),
  ratePercent: new Decimal('20'),
});
const taxDe = calculateTax({
  mode: 'add',
  amount: new Decimal('1000'),
  ratePercent: new Decimal('19'),
});
const taxDeRemove = calculateTax({
  mode: 'remove',
  amount: new Decimal('1000'),
  ratePercent: new Decimal('19'),
});
if (!taxUk.ok || !taxDe.ok || !taxDeRemove.ok) throw new Error('home tax example failed');

const markup = calculateMarkupMargin({
  mode: 'margin',
  cost: new Decimal('100'),
  price: new Decimal('150'),
});
if (!markup.ok) throw new Error(`home markup example failed: ${markup.code}`);

const quoteDraft = quoteExample();
const receiptDraft = receiptExample();

const totalsFor = (draft: typeof quoteDraft) =>
  calculateDocumentTotals({
    items: draft.items.map((item) => ({
      ...item,
      discountPercent: item.discountPercent || undefined,
      taxPercent: item.taxPercent || undefined,
    })),
    discountPercent: draft.discountPercent || undefined,
    amountPaid: draft.amountPaid || undefined,
  });

const quoteTotals = totalsFor(quoteDraft);
const receiptTotals = totalsFor(receiptDraft);

const today = todayIso();
const reminderDue = addDays(today, -7);
const reminderMessages = REMINDER_TONES.map((tone) => {
  const result = buildReminder({
    tone,
    customerName: 'Alex Morgan',
    invoiceNumber: 'INV-0041',
    amountDue: new Decimal('1669.20'),
    currency: 'GBP',
    dueDate: reminderDue,
    paymentLink: '',
    businessName: 'Northwind Studio',
    daysOverdue: 7,
  });
  const paragraphs = result.body
    .split('\n\n')
    .map((part) => part.trim())
    .filter(Boolean);
  const labels: Record<string, string> = {
    friendly: 'Friendly',
    professional: 'Professional',
    firm: 'Firm',
    final: 'Final notice',
  };
  return {
    label: labels[tone] ?? tone,
    subject: result.subject || 'A quick note about the invoice',
    opening: paragraphs[0] ?? '',
    second: paragraphs[1] ?? '',
    third: paragraphs[2] ?? '',
  };
});

// The invoice demo uses the same line items in each market, with that market's
// currency, tax name, title and rate. All totals come from the document engine.
const invoiceLines = [
  { id: 'brand', description: 'Brand identity', quantity: 1, unitPrice: 1200 },
  { id: 'system', description: 'Design system, 7.5 h', quantity: 7.5, unitPrice: 95.5 },
];

const markets = [
  { code: 'UK', label: 'UK', taxLabel: 'VAT', taxRate: '20', currency: 'GBP' as CurrencyCode, title: 'VAT INVOICE', number: 'INV-1042' },
  { code: 'US', label: 'US', taxLabel: 'Sales tax', taxRate: '8.25', currency: 'USD' as CurrencyCode, title: 'INVOICE', number: 'INV-1042' },
  { code: 'DE', label: 'Germany', taxLabel: 'MwSt', taxRate: '19', currency: 'EUR' as CurrencyCode, title: 'RECHNUNG', number: 'RE-1042' },
  { code: 'IN', label: 'India', taxLabel: 'GST', taxRate: '18', currency: 'INR' as CurrencyCode, title: 'TAX INVOICE', number: 'INV-1042' },
];

const invoiceMarkets = markets.map((market) => {
  const totals = calculateDocumentTotals({
    items: invoiceLines.map((line) => ({ ...line, taxPercent: market.taxRate })),
  });
  const config = getCountryConfig(market.code as Parameters<typeof getCountryConfig>[0]);
  return {
    code: market.code,
    label: market.label,
    title: market.title,
    taxLabel: market.taxLabel,
    taxRate: market.taxRate,
    line1: formatCurrency(new Decimal('1200'), market.currency),
    line2: formatCurrency(new Decimal('716.25'), market.currency),
    net: formatCurrency(new Decimal('1916.25'), market.currency),
    tax: formatCurrency(totals.taxTotal, market.currency),
    total: formatCurrency(totals.total, market.currency),
    number: market.number,
    payment: config.invoice.paymentTerms,
  };
});

const countryCards = [
  { code: 'US', name: 'United States', region: 'US', href: '/us/invoice-generator/' },
  { code: 'UK', name: 'United Kingdom', region: 'UK', href: '/uk/vat-invoice-generator/' },
  { code: 'CA', name: 'Canada', region: 'CA', href: '/ca/gst-hst-invoice-generator/' },
  { code: 'AU', name: 'Australia', region: 'AU', href: '/au/tax-invoice-generator/' },
  { code: 'DE', name: 'Germany', region: 'DE', href: '/de/vat-invoice-generator/' },
  { code: 'CH', name: 'Switzerland', region: 'CH', href: '/ch/vat-invoice-generator/' },
  { code: 'IN', name: 'India', region: 'IN', href: '/in/gst-invoice-generator/' },
  { code: 'AE', name: 'United Arab Emirates', region: 'AE', href: '/ae/vat-invoice-generator/' },
].map((entry) => {
  const config = getCountryConfig(entry.region as Parameters<typeof getCountryConfig>[0]);
  return {
    ...entry,
    tax: `${config.tax.label} ${config.tax.standardRatePercent}%`,
    title: config.tax.supportsTaxInvoice ? config.tax.taxInvoiceTitle : config.invoice.documentTitle,
  };
});
---

<BaseLayout
  title="SoloYolo: business calculators and invoices for independent work"
  description="Free business calculators and print-ready invoice tools for freelancers and small businesses. Exact decimal maths, eight invoice markets, no account and nothing uploaded."
  path="/"
>
  <section class="hero" aria-labelledby="home-heading">
    <div class="wrap hero-grid">
      <div class="hero-copy" data-enter style="--enter-i: 1">
        <h1 id="home-heading">Business tools for independent work.</h1>
        <p class="hero-lede">
          Price the work, send the document, keep the numbers. Twelve tools and eight invoice
          markets, with exact decimal maths and nothing uploaded.
        </p>

        <button
          type="button"
          class="command-bar"
          data-open-palette
          aria-label="Search tools and country guides"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M7 12A5 5 0 1 0 7 2a5 5 0 0 0 0 10zm4.5-.5L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          <span>What do you need to work out?</span>
          <kbd aria-hidden="true">⌘K</kbd>
        </button>

        <div class="hero-actions">
          <a href="/calculators/hourly-rate-calculator/" class="btn btn-primary sq">Find your rate</a>
          <a href="/generators/invoice-generator/" class="btn btn-secondary sq">Make an invoice</a>
        </div>

        <p class="hero-note">12 tools, 8 invoice markets. Free, no account, nothing uploaded.</p>
      </div>

      <div class="hero-demo" data-enter style="--enter-i: 2">
        <RatePass
          rate={rateRaw}
          quote={quoteFormatted}
          tax={heroTax}
          total={heroTotal}
          totalRaw={heroTotalRaw}
          income="$80,000"
          costs="$12,000"
          weeks={48}
          hours={25}
          revenue={requiredRevenue}
          capacity={billableHours}
        />
        <div class="demo-controls">
          <button type="button" class="demo-pause" data-demo-pause aria-pressed="false">
            <span data-demo-pause-label>Pause motion</span>
          </button>
          <span class="demo-caption">Every number comes from the same engine.</span>
        </div>
      </div>
    </div>
  </section>

  <ToolDock hourlyRevenue={requiredRevenue} marketCount={8} />

  <aside class="ad-band" aria-label="Advertisement">
    <div class="wrap">
      <AdSlot name="leaderboard" />
    </div>
  </aside>

  <section class="showcase" aria-labelledby="numbers-heading">
    <div class="wrap">
      <div class="section-line">
        <h2 id="numbers-heading">See the numbers before you send them.</h2>
        <p>Change the market, the fee or the contractor and the result follows.</p>
      </div>

      <div class="showcase-grid numbers-grid">
        <div class="tile tile-invoice tile-span-8 tile-rows-2">
          <a class="tile-link-cover" href="/generators/invoice-generator/" aria-label="Open the invoice generator"></a>
          <div class="tile-heading">
            <h3>One invoice, four markets</h3>
            <span class="tile-go" aria-hidden="true">→</span>
          </div>
          <InvoiceCountries countries={invoiceMarkets} />
        </div>

        <div class="tile tile-profit tile-span-4 tile-rows-2">
          <a class="tile-link-cover" href="/calculators/project-profit-calculator/" aria-label="Open the project profit calculator"></a>
          <div class="tile-heading">
            <h3>What a project really leaves</h3>
            <span class="tile-go" aria-hidden="true">→</span>
          </div>
          <ProjectProfitDemo
            revenue="$6,000"
            labor="$1,800"
            contractor="$600"
            software="$120"
            other="$80"
            overhead="$700"
            profit={formatCurrency(projectBase.value.profitRounded, 'USD', { decimals: 0 })}
            margin={(projectBase.value.margin?.times(100) ?? new Decimal(0)).toFixed(0)}
            profitRaw={projectBase.value.profitRounded.toFixed(0)}
            marginRaw={(projectBase.value.margin?.times(100) ?? new Decimal(0)).toFixed(0)}
            profitWide={formatCurrency(projectWide.value.profitRounded, 'USD', { decimals: 0 })}
            marginWide={(projectWide.value.margin?.times(100) ?? new Decimal(0)).toFixed(0)}
            profitWideRaw={projectWide.value.profitRounded.toFixed(0)}
            marginWideRaw={(projectWide.value.margin?.times(100) ?? new Decimal(0)).toFixed(0)}
            markup={(projectBase.value.markup?.times(100) ?? new Decimal(0)).toFixed(0)}
            markupWide={(projectWide.value.markup?.times(100) ?? new Decimal(0)).toFixed(0)}
          />
        </div>

        <div class="tile tile-fees tile-span-6">
          <a class="tile-link-cover" href="/calculators/payment-processing-fee-calculator/" aria-label="Open the payment fee calculator"></a>
          <div class="tile-heading">
            <h3>What lands after the fee</h3>
            <span class="tile-go" aria-hidden="true">→</span>
          </div>
          <PaymentFeeDemo
            amount="$1,000.00"
            fee={formatCurrency(paymentBase.value.totalFeeRounded, 'USD')}
            net={formatCurrency(paymentBase.value.netRounded, 'USD')}
            feeRaw={paymentBase.value.totalFeeRounded.toFixed(2)}
            netRaw={paymentBase.value.netRounded.toFixed(2)}
            feeWide={formatCurrency(paymentWide.value.totalFeeRounded, 'USD')}
            netWide={formatCurrency(paymentWide.value.netRounded, 'USD')}
            feeWideRaw={paymentWide.value.totalFeeRounded.toFixed(2)}
            netWideRaw={paymentWide.value.netRounded.toFixed(2)}
          />
        </div>

        <div class="tile tile-tax tile-span-6">
          <a class="tile-link-cover" href="/calculators/vat-gst-sales-tax-calculator/" aria-label="Open the tax calculator"></a>
          <div class="tile-heading">
            <h3>Add it or take it out</h3>
            <span class="tile-go" aria-hidden="true">→</span>
          </div>
          <TaxDemo
            amount="£1,000"
            ukLabel="VAT"
            ukRate="20"
            ukTax={formatCurrency(taxUk.value.taxRounded, 'GBP')}
            ukTaxRaw={taxUk.value.taxRounded.toFixed(2)}
            ukTotal={formatCurrency(taxUk.value.grossRounded, 'GBP')}
            deLabel="MwSt"
            deRate="19"
            deTax={formatCurrency(taxDe.value.taxRounded, 'GBP')}
            deTaxRaw={taxDe.value.taxRounded.toFixed(2)}
            deTotal={formatCurrency(taxDe.value.grossRounded, 'GBP')}
            deNet={formatCurrency(taxDeRemove.value.netRounded, 'GBP')}
            deNetRaw={taxDeRemove.value.netRounded.toFixed(2)}
          />
        </div>
      </div>
    </div>
  </section>

  <aside class="ad-band" aria-label="Advertisement">
    <div class="wrap">
      <AdSlot name="infeed" />
    </div>
  </aside>

  <section class="showcase" aria-labelledby="send-heading">
    <div class="wrap paper-layout">
      <div class="paper-main">
        <div class="section-line">
          <h2 id="send-heading">Send the document, keep the record.</h2>
          <p>Quote, invoice, receipt and a reminder that asks once, politely.</p>
        </div>

        <div class="showcase-grid send-grid">
          <div class="tile tile-reminder tile-span-7">
            <a class="tile-link-cover" href="/generators/payment-reminder-generator/" aria-label="Open the payment reminder generator"></a>
            <div class="tile-heading">
              <h3>Ask once, politely</h3>
              <span class="tile-go" aria-hidden="true">→</span>
            </div>
            <ReminderDemo messages={reminderMessages} invoice="INV-0041" amount="£1,669.20" customer="Alex Morgan" />
          </div>

          <div class="tile tile-desk tile-span-5">
            <div class="tile-heading">
              <h3>Your desk</h3>
            </div>
            <TodayDashboard variant="compact" client:idle />
          </div>

          <div class="tile tile-documents tile-span-12">
            <a class="tile-link-cover" href="/generators/quote-generator/" aria-label="Open the quote generator"></a>
            <div class="tile-heading">
              <h3>Two documents, one engine</h3>
              <span class="tile-go" aria-hidden="true">→</span>
            </div>
            <DocumentsDemo
              quoteNumber={quoteDraft.number}
              quoteTotal={formatCurrency(quoteTotals.total, 'GBP')}
              quoteDate={formatDateShort(quoteDraft.expiryDate)}
              receiptNumber={receiptDraft.number}
              receiptTotal={formatCurrency(receiptTotals.total, 'GBP')}
              receiptDate={formatDateShort(receiptDraft.transactionDate)}
            />
          </div>
        </div>
      </div>

      <aside class="ad-rail" aria-label="Sponsored">
        <AdSlot name="sidebar" />
      </aside>
    </div>
  </section>

  <aside class="ad-band" aria-label="Advertisement">
    <div class="wrap">
      <AdSlot name="infeed" />
    </div>
  </aside>

  <section class="showcase country-section" aria-labelledby="countries-heading">
    <div class="wrap">
      <div class="section-line">
        <h2 id="countries-heading">Eight invoice markets, one document.</h2>
        <p>Tax names, registration fields and printed titles, each with an official source.</p>
      </div>

      <div class="country-cards" data-country-grid>
        {countryCards.map((country) => (
          <a
            class="country-card"
            href={country.href}
            data-region={country.region}
            data-code={country.code}
          >
            <span class="country-code">{country.code}</span>
            <span class="country-name">{country.name}</span>
            <span class="country-tax">{country.tax}</span>
            <span class="country-title">{country.title}</span>
            <span class="country-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <p class="country-foot">
        <a href="/countries/">All country guides</a>
        <span>Sources and verified dates travel with every market.</span>
      </p>
    </div>
  </section>

  <aside class="ad-band" aria-label="Advertisement">
    <div class="wrap">
      <AdSlot name="leaderboard" />
    </div>
  </aside>

  <section class="closing" aria-labelledby="close-heading">
    <div class="wrap closing-grid">
      <div>
        <h2 id="close-heading">Two minutes with real numbers beats another guess.</h2>
        <p>Free, private and open on the first tap.</p>
      </div>
      <div class="closing-actions">
        <a href="/calculators/hourly-rate-calculator/" class="btn btn-primary sq">Find your rate</a>
        <a href="/generators/invoice-generator/" class="btn btn-secondary sq">Make an invoice</a>
      </div>
    </div>
    <div class="wrap closing-ad">
      <AdSlot name="end" />
    </div>
  </section>

  <AdSlot name="anchor" />
</BaseLayout>

<script>
  import '@/scripts/home-demos';

  // The visitor's own market leads the country row. The cards stay links, so
  // the script only reorders them and leaves the accessible order intact.
  const grid = document.querySelector<HTMLElement>('[data-country-grid]');

  if (grid) {
    const codes: Record<string, string> = {
      US: 'US',
      GB: 'UK',
      CA: 'CA',
      AU: 'AU',
      DE: 'DE',
      CH: 'CH',
      IN: 'IN',
      AE: 'AE',
    };
    const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>('[data-region]'));
    const locale = window.navigator.language.split('-')[1]?.toUpperCase() ?? '';
    const match = cards.find((card) => card.dataset.region === codes[locale]);
    if (match) {
      grid.prepend(match);
      match.dataset.own = 'true';
    }
  }
</script>

