---
import Decimal from 'decimal.js';

import AdSlot from '@/components/ads/AdSlot.astro';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import InvoiceCountries from '@/components/home/demos/InvoiceCountries.astro';
import PaymentFeeDemo from '@/components/home/demos/PaymentFee.astro';
import RatePass from '@/components/home/demos/RatePass.astro';
import ReminderDemo from '@/components/home/demos/Reminder.astro';
import TodayDashboard from '@/components/home/TodayDashboard';
import ToolDirectory from '@/components/home/ToolDirectory.astro';
import { calculateHourlyRate, quoteWork } from '@/lib/calculators/hourlyRate';
import { calculatePaymentFee } from '@/lib/calculators/paymentFee';
import { getCountryConfig } from '@/lib/countries';
import { buildReminder, REMINDER_TONES } from '@/lib/generators/reminder';
import { calculateDocumentTotals } from '@/lib/generators/totals';
import { addDays, todayIso } from '@/lib/formatting/date';
import { formatCurrency, type CurrencyCode } from '@/lib/formatting/currency';
import { formatNumber } from '@/lib/formatting/number';

// ---------------------------------------------------------------------------
// Every figure below is produced by the same engine the tool runs. The build
// fails if an example does not calculate, so the home cannot drift.
// ---------------------------------------------------------------------------

const hourly = calculateHourlyRate({
  targetIncome: new Decimal('80000'),
  annualExpenses: new Decimal('12000'),
  workingWeeks: new Decimal('48'),
  billableHoursPerWeek: new Decimal('25'),
});
if (!hourly.ok) throw new Error(`home hourly example failed: ${hourly.code}`);

const rate = hourly.value.hourlyRateRounded;
const rateRaw = rate.toFixed(2);
const quote = quoteWork(rate, 40);
const quoteFormatted = formatCurrency(quote, 'USD');
const requiredRevenue = formatCurrency(hourly.value.requiredAnnualRevenue, 'USD', { decimals: 0 });
const billableHours = formatNumber(hourly.value.billableHoursPerYear.toNumber());

const heroInvoice = calculateDocumentTotals({
  items: [
    {
      id: 'hero-line',
      description: 'Brand identity, 40 hours',
      quantity: 40,
      unitPrice: rate,
      taxPercent: 8.25,
    },
  ],
});
const heroTax = formatCurrency(heroInvoice.taxTotal, 'USD');
const heroTotal = formatCurrency(heroInvoice.total, 'USD');
const heroTotalRaw = heroInvoice.total.toFixed(2);

const paymentBase = calculatePaymentFee({
  amount: new Decimal('1000'),
  percentFee: new Decimal('2.9'),
  fixedFee: new Decimal('0.30'),
});
if (!paymentBase.ok) throw new Error(`home fee base failed: ${paymentBase.code}`);

const paymentWide = calculatePaymentFee({
  amount: new Decimal('1000'),
  percentFee: new Decimal('1.75'),
  fixedFee: new Decimal('0.25'),
});
if (!paymentWide.ok) throw new Error(`home fee wide failed: ${paymentWide.code}`);

const today = todayIso();
const reminderDue = addDays(today, -7);
const reminderMessages = REMINDER_TONES.map((tone) => {
  const result = buildReminder({
    tone,
    customerName: 'Alex Morgan',
    invoiceNumber: 'INV-0041',
    amountDue: new Decimal('1669.20'),
    currency: 'GBP',
    dueDate: reminderDue,
    paymentLink: '',
    businessName: 'Northwind Studio',
    daysOverdue: 7,
  });
  const paragraphs = result.body
    .split('\n\n')
    .map((part) => part.trim())
    .filter(Boolean);
  const labels: Record<string, string> = {
    friendly: 'Friendly',
    professional: 'Professional',
    firm: 'Firm',
    final: 'Final notice',
  };
  return {
    label: labels[tone] ?? tone,
    subject: result.subject || 'A quick note about the invoice',
    opening: paragraphs[0] ?? '',
    second: paragraphs[1] ?? '',
    third: paragraphs[2] ?? '',
  };
});

// The invoice demo uses the same line items in each market, with that market's
// currency, tax name, title and rate. All totals come from the document engine.
const invoiceLines = [
  { id: 'brand', description: 'Brand identity', quantity: 1, unitPrice: 1200 },
  { id: 'system', description: 'Design system, 7.5 h', quantity: 7.5, unitPrice: 95.5 },
];

const markets = [
  {
    code: 'UK',
    label: 'UK',
    taxLabel: 'VAT',
    taxRate: '20',
    currency: 'GBP' as CurrencyCode,
    title: 'VAT INVOICE',
    number: 'INV-1042',
  },
  {
    code: 'US',
    label: 'US',
    taxLabel: 'Sales tax',
    taxRate: '8.25',
    currency: 'USD' as CurrencyCode,
    title: 'INVOICE',
    number: 'INV-1042',
  },
  {
    code: 'DE',
    label: 'Germany',
    taxLabel: 'MwSt',
    taxRate: '19',
    currency: 'EUR' as CurrencyCode,
    title: 'RECHNUNG',
    number: 'RE-1042',
  },
  {
    code: 'IN',
    label: 'India',
    taxLabel: 'GST',
    taxRate: '18',
    currency: 'INR' as CurrencyCode,
    title: 'TAX INVOICE',
    number: 'INV-1042',
  },
];

const invoiceMarkets = markets.map((market) => {
  const totals = calculateDocumentTotals({
    items: invoiceLines.map((line) => ({ ...line, taxPercent: market.taxRate })),
  });
  const config = getCountryConfig(market.code as Parameters<typeof getCountryConfig>[0]);
  return {
    code: market.code,
    label: market.label,
    title: market.title,
    taxLabel: market.taxLabel,
    taxRate: market.taxRate,
    line1: formatCurrency(new Decimal('1200'), market.currency),
    line2: formatCurrency(new Decimal('716.25'), market.currency),
    net: formatCurrency(new Decimal('1916.25'), market.currency),
    tax: formatCurrency(totals.taxTotal, market.currency),
    total: formatCurrency(totals.total, market.currency),
    number: market.number,
    due: `In ${config.invoice.dueDays} days`,
    payment: config.invoice.paymentTerms,
  };
});

const countryCards = [
  { code: 'US', name: 'United States', region: 'US', href: '/us/invoice-generator/' },
  { code: 'UK', name: 'United Kingdom', region: 'UK', href: '/uk/vat-invoice-generator/' },
  { code: 'CA', name: 'Canada', region: 'CA', href: '/ca/gst-hst-invoice-generator/' },
  { code: 'AU', name: 'Australia', region: 'AU', href: '/au/tax-invoice-generator/' },
  { code: 'DE', name: 'Germany', region: 'DE', href: '/de/vat-invoice-generator/' },
  { code: 'CH', name: 'Switzerland', region: 'CH', href: '/ch/vat-invoice-generator/' },
  { code: 'IN', name: 'India', region: 'IN', href: '/in/gst-invoice-generator/' },
  { code: 'AE', name: 'United Arab Emirates', region: 'AE', href: '/ae/vat-invoice-generator/' },
].map((entry) => {
  const config = getCountryConfig(entry.region as Parameters<typeof getCountryConfig>[0]);
  return {
    ...entry,
    // The US has no national rate (its config keeps 0 on purpose), so the
    // card must not print "Sales tax 0%": say what is true instead.
    tax:
      config.tax.standardRatePercent === '0'
        ? `${config.tax.label} varies by state`
        : `${config.tax.label} ${config.tax.standardRatePercent}%`,
    title: config.tax.supportsTaxInvoice
      ? config.tax.taxInvoiceTitle
      : config.invoice.documentTitle,
  };
});
---

<BaseLayout
  title="soloyolo: business calculators and invoices for independent work"
  description="Free business calculators and print-ready invoice tools for freelancers and small businesses. Exact decimal maths, eight invoice markets, no account and nothing uploaded."
  path="/"
>
  <section class="hero" aria-labelledby="home-heading">
    <div class="wrap hero-grid">
      <div class="hero-copy" data-enter style="--enter-i: 1">
        <h1 id="home-heading">Business tools for independent work.</h1>
        <p class="hero-lede">
          Made for freelancers, consultants, creators, contractors and small business owners. Use it
          to set a fair rate, check what a project really earns, add or remove tax, make a quote or
          invoice, or send a polite reminder when a payment is late — at your desk or on your phone.
          Every tool explains itself in plain language, runs in your browser, and needs no account,
          setup or upload.
        </p>

        <button
          type="button"
          class="command-bar"
          data-open-palette
          aria-label="Search tools and country guides"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M7 12A5 5 0 1 0 7 2a5 5 0 0 0 0 10zm4.5-.5L14 14"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            ></path>
          </svg>
          <span>What do you need to work out?</span>
          <kbd aria-hidden="true">⌘K</kbd>
        </button>

        <div class="hero-actions">
          <a href="/calculators/hourly-rate-calculator/" class="btn btn-primary sq">
            Find your rate
          </a>
          <a href="/generators/invoice-generator/" class="btn btn-secondary sq">
            Make an invoice
          </a>
          <a href="/tools/" class="hero-browse">
            Browse all 12 tools <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="hero-demo" data-enter style="--enter-i: 2">
        <RatePass
          rate={rateRaw}
          quote={quoteFormatted}
          tax={heroTax}
          total={heroTotal}
          totalRaw={heroTotalRaw}
          income="$80,000"
          costs="$12,000"
          weeks={48}
          hours={25}
          revenue={requiredRevenue}
          capacity={billableHours}
        />
        <div class="demo-controls">
          <button type="button" class="demo-pause" data-demo-pause aria-pressed="false">
            <span data-demo-pause-label>Pause motion</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <aside class="ad-band" aria-label="Advertisement">
    <div class="wrap">
      <AdSlot name="leaderboard" />
    </div>
  </aside>

  <section class="tools-section" aria-labelledby="tools-heading">
    <div class="wrap">
      <div class="section-line">
        <div>
          <p class="eyebrow">The toolkit</p>
          <h2 id="tools-heading">Every tool, one place.</h2>
        </div>
      </div>

      <div class="paper-layout">
        <ToolDirectory />

        <aside class="ad-rail" aria-label="Sponsored">
          <AdSlot name="sidebar" />
        </aside>
      </div>
    </div>
  </section>

  <section class="desk-section" aria-label="Your desk">
    <TodayDashboard variant="compact" client:idle />
  </section>

  <aside class="ad-band" aria-label="Advertisement">
    <div class="wrap">
      <AdSlot name="infeed" />
    </div>
  </aside>

  <section class="proof-section" aria-labelledby="proof-heading">
    <div class="wrap">
      <div class="section-line">
        <div>
          <p class="eyebrow">Live examples</p>
          <h2 id="proof-heading">See the numbers before you send them.</h2>
        </div>
      </div>

      <div class="proof-grid">
        <div class="tile tile-invoice">
          <a
            class="tile-link-cover"
            href="/generators/invoice-generator/"
            aria-label="Open the invoice generator"
          ></a>
          <div class="tile-heading">
            <h3>One invoice, four markets</h3>
            <span class="tile-go" aria-hidden="true">
              →
            </span>
          </div>
          <InvoiceCountries countries={invoiceMarkets} />
        </div>

        <div class="tile tile-fees">
          <a
            class="tile-link-cover"
            href="/calculators/payment-processing-fee-calculator/"
            aria-label="Open the payment fee calculator"
          ></a>
          <div class="tile-heading">
            <h3>What lands after the fee</h3>
            <span class="tile-go" aria-hidden="true">
              →
            </span>
          </div>
          <PaymentFeeDemo
            amount="$1,000.00"
            fee={formatCurrency(paymentBase.value.totalFeeRounded, 'USD')}
            net={formatCurrency(paymentBase.value.netRounded, 'USD')}
            feeRaw={paymentBase.value.totalFeeRounded.toFixed(2)}
            netRaw={paymentBase.value.netRounded.toFixed(2)}
            feeWide={formatCurrency(paymentWide.value.totalFeeRounded, 'USD')}
            netWide={formatCurrency(paymentWide.value.netRounded, 'USD')}
            feeWideRaw={paymentWide.value.totalFeeRounded.toFixed(2)}
            netWideRaw={paymentWide.value.netRounded.toFixed(2)}
          />
        </div>

        <div class="tile tile-reminder">
          <a
            class="tile-link-cover"
            href="/generators/payment-reminder-generator/"
            aria-label="Open the payment reminder generator"
          ></a>
          <div class="tile-heading">
            <h3>Ask once, politely</h3>
            <span class="tile-go" aria-hidden="true">
              →
            </span>
          </div>
          <ReminderDemo
            messages={reminderMessages}
            invoice="INV-0041"
            amount="£1,669.20"
            customer="Alex Morgan"
          />
        </div>
      </div>
    </div>
  </section>

  <aside class="ad-band" aria-label="Advertisement">
    <div class="wrap">
      <AdSlot name="infeed" />
    </div>
  </aside>

  <section class="country-section" aria-labelledby="countries-heading">
    <div class="wrap">
      <div class="section-line">
        <div>
          <p class="eyebrow">Markets</p>
          <h2 id="countries-heading">Eight invoice markets, one document.</h2>
        </div>
      </div>

      <div class="country-cards" data-country-grid>
        {countryCards.map((country) => (
          <a
            class="country-card"
            href={country.href}
            data-region={country.region}
            data-code={country.code}
          >
            <span class="country-code">{country.code}</span>
            <span class="country-name">{country.name}</span>
            <span class="country-tax">{country.tax}</span>
            <span class="country-title">{country.title}</span>
            <span class="country-go" aria-hidden="true">
              →
            </span>
          </a>
        ))}
      </div>
      <p class="country-foot">
        <a href="/countries/">All country guides</a>
      </p>
    </div>
  </section>

  <aside class="ad-band" aria-label="Advertisement">
    <div class="wrap">
      <AdSlot name="leaderboard" />
    </div>
  </aside>

  <section class="closing" aria-labelledby="close-heading">
    <div class="wrap closing-grid">
      <div>
        <h2 id="close-heading">Two minutes with real numbers beats another guess.</h2>
        <p>Free, private and open on the first tap.</p>
      </div>
      <div class="closing-actions">
        <a href="/calculators/hourly-rate-calculator/" class="btn btn-primary sq">
          Find your rate
        </a>
        <a href="/generators/invoice-generator/" class="btn btn-secondary sq">
          Make an invoice
        </a>
      </div>
    </div>
    <div class="wrap closing-ad">
      <AdSlot name="end" />
    </div>
  </section>

  <AdSlot name="anchor" />
</BaseLayout>

<script>
  import '@/scripts/home-demos';

  // The visitor's own market leads the country row. The cards stay links, so
  // the script only reorders them and leaves the accessible order intact.
  const grid = document.querySelector<HTMLElement>('[data-country-grid]');

  if (grid) {
    const codes: Record<string, string> = {
      US: 'US',
      GB: 'UK',
      CA: 'CA',
      AU: 'AU',
      DE: 'DE',
      CH: 'CH',
      IN: 'IN',
      AE: 'AE',
    };
    const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>('[data-region]'));
    const locale = window.navigator.language.split('-')[1]?.toUpperCase() ?? '';
    const match = cards.find((card) => card.dataset.region === codes[locale]);
    if (match) {
      grid.prepend(match);
      match.dataset.own = 'true';
    }
  }

  // The rail is sticky in CSS; this only warms its edge once it is stuck, so
  // the transition has a cause rather than firing on every scroll frame.
  const rail = document.querySelector<HTMLElement>('.ad-rail');
  const railSlot = rail?.querySelector<HTMLElement>('.ad-slot-sidebar');

  if (rail && railSlot) {
    let frame = 0;
    const markStuck = () => {
      frame = 0;
      railSlot.dataset.stuck = String(rail.getBoundingClientRect().top <= 97);
    };
    const schedule = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(markStuck);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    markStuck();
  }
</script>
