---
import Decimal from 'decimal.js';

import AdSlot from '@/components/ads/AdSlot.astro';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ToolCard from '@/components/ui/ToolCard.astro';
import QuickEstimator from '@/components/home/QuickEstimator';
import TodayDashboard from '@/components/home/TodayDashboard';
import { SITE } from '@/config/site';
import { calculateHourlyRate, quoteWork } from '@/lib/calculators/hourlyRate';
import { formatCurrency } from '@/lib/formatting/currency';
import { formatNumber } from '@/lib/formatting/number';
import { liveTools } from '@/lib/tools';

const calculators = liveTools('calculator');
const generators = liveTools('generator');
const siteUrl = Astro.site ?? new URL('https://ledgerly.example.com');

const example = calculateHourlyRate({
  targetIncome: new Decimal('80000'),
  annualExpenses: new Decimal('12000'),
  workingWeeks: new Decimal('48'),
  billableHoursPerWeek: new Decimal('25'),
});

// The proof section prints engine output only. If the engine ever refuses
// these inputs, the build fails instead of shipping drifted numbers.
if (!example.ok) {
  throw new Error(`home worked example failed: ${example.code}`);
}

const exampleRate = formatCurrency(example.value.hourlyRateRounded, 'USD');
const exampleRevenue = formatCurrency(example.value.requiredAnnualRevenue, 'USD');
const exampleHours = formatNumber(example.value.billableHoursPerYear);
const exampleQuote = formatCurrency(quoteWork(example.value.hourlyRateRounded, 40), 'USD');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: siteUrl.href,
    description: SITE.description,
    logo: new URL('/apple-touch-icon.png', siteUrl).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: siteUrl.href,
    inLanguage: 'en',
  },
];

const glow = (x: string, y: string, c: string) =>
  `radial-gradient(42rem 28rem at ${x} ${y}, ${c}, transparent 70%)`;

const countries = [
  { code: 'US', region: 'US', name: 'United States', href: '/us/invoice-generator/', note: 'Standard + W-9' },
  { code: 'GB', region: 'UK', name: 'United Kingdom', href: '/uk/vat-invoice-generator/', note: 'HMRC VAT 20%' },
  { code: 'CA', region: 'CA', name: 'Canada', href: '/ca/gst-hst-invoice-generator/', note: 'GST/HST / CRA' },
  { code: 'AU', region: 'AU', name: 'Australia', href: '/au/tax-invoice-generator/', note: 'ATO Tax Invoice' },
  { code: 'DE', region: 'EU', name: 'Germany', href: '/de/vat-invoice-generator/', note: 'Rechnung §19 UStG' },
  { code: 'CH', region: 'EU', name: 'Switzerland', href: '/ch/vat-invoice-generator/', note: 'MWST 8.1% / TVA' },
  { code: 'IN', region: 'IN', name: 'India', href: '/in/gst-invoice-generator/', note: 'GST CGST+SGST' },
  { code: 'AE', region: 'MEA', name: 'United Arab Emirates', href: '/ae/vat-invoice-generator/', note: 'FTA 5% VAT' },
] as const;
---

<BaseLayout
  title="SoloYolo: your home base for independent work"
  description={SITE.description}
  path="/"
  jsonLd={jsonLd}
>
  <!-- S0: One screen. The four quick actions are the primary tools, one click away. -->
  <section class="home-hero" style={`background-image: ${glow('84%', '8%', 'rgb(43 127 255 / 0.13)')}`}>
    <div class="wrap home-hero-grid">
      <div class="hero-copy">
        <div class="hero-badges" data-enter style="--enter-i: 0">
          <span class="hero-badge sq">Your home base</span>
          <span class="hero-badge-quiet">Free · Private · No account</span>
        </div>
        <h1 data-enter style="--enter-i: 1">
          Run your solo business from one desk.
        </h1>
        <p class="hero-lede" data-enter style="--enter-i: 2">
          Price the work, send the paperwork, keep the momentum. Every tool runs
          in your browser, with exact decimal maths and nothing uploaded.
        </p>
        <ul class="hero-trust" data-enter style="--enter-i: 3">
          <li>One click to your top tools</li>
          <li>Free, forever, no sign-up</li>
          <li>Works offline on saved data</li>
        </ul>
      </div>

      <div class="quick-actions" aria-label="Quick actions" data-enter style="--enter-i: 2">
        <a href="/generators/invoice-generator/" class="quick-action sq is-primary" data-quick="invoice">
          <span class="quick-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M5 2.75h7l3 3v11.5H5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
              <path d="M12 2.75v3h3M7.5 10h5M7.5 13h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </span>
          <span class="quick-text"><strong>New invoice</strong><small>Print-ready PDF</small></span>
          <kbd>2</kbd>
        </a>

        <button type="button" class="quick-action sq" data-quick="timer">
          <span class="quick-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <circle cx="10" cy="11" r="6.25" stroke="currentColor" stroke-width="1.5" />
              <path d="M10 7.5v3.8l2.3 1.4M8 2.5h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </span>
          <span class="quick-text"><strong>Start timer</strong><small>Log billable hours</small></span>
        </button>

        <button type="button" class="quick-action sq" data-quick="clients">
          <span class="quick-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <circle cx="8" cy="7" r="3" stroke="currentColor" stroke-width="1.5" />
              <path d="M3 16c0-2.8 2.2-5 5-5s5 2.2 5 5M14.5 7.5v4M12.5 9.5h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </span>
          <span class="quick-text"><strong>Add client</strong><small>Stays on this device</small></span>
        </button>

        <button type="button" class="quick-action sq" data-open-palette>
          <span class="quick-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <circle cx="9" cy="9" r="5.25" stroke="currentColor" stroke-width="1.5" />
              <path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </span>
          <span class="quick-text"><strong>Find a tool</strong><small>Search all tools & guides</small></span>
          <kbd>⌘K</kbd>
        </button>
      </div>
    </div>
  </section>

  <!-- S1: The daily cockpit. Real local state, honest empty states, no fake urgency. -->
  <TodayDashboard client:idle />

  <!-- Top leaderboard: at the bottom of the first screen, highest viewability. -->
  <div class="wrap ad-band">
    <AdSlot name="leaderboard" />
  </div>

  <!-- S2: The toolkit. QuickEstimator is a real tool, not a marketing mock. -->
  <section class="screen tools-section" aria-labelledby="tools-heading" style={`background-image: ${glow('6%', '26%', 'rgb(43 127 255 / 0.09)')}`}>
    <div class="wrap tools-shell">
      <div class="tools-main">
        <header class="section-head">
          <div>
            <p class="eyebrow">The toolkit · 12 live tools</p>
            <h2 id="tools-heading">Price it. Send it. Get paid.</h2>
            <p class="section-lede">
              Calculators use exact decimal arithmetic. Generators print clean,
              country-aware documents. No account, no uploads.
            </p>
          </div>
          <div class="section-links">
            <a href="/calculators/" class="btn btn-secondary sq btn-sm">All calculators <span aria-hidden="true">→</span></a>
            <a href="/generators/" class="btn btn-secondary sq btn-sm">All generators <span aria-hidden="true">→</span></a>
          </div>
        </header>

        <QuickEstimator client:idle />

        <div class="tool-group">
          <div class="group-head">
            <h3>Calculators &amp; pricing</h3>
            <span>{calculators.length} live tools</span>
          </div>
          <div class="tool-grid">
            {calculators.map((tool) => <ToolCard tool={tool} />)}
          </div>
        </div>

        <AdSlot name="infeed" />

        <div class="tool-group">
          <div class="group-head">
            <h3>Documents &amp; getting paid</h3>
            <span>{generators.length} live tools</span>
          </div>
          <div class="tool-grid">
            {generators.map((tool) => <ToolCard tool={tool} badge="Generator" />)}
          </div>
        </div>
      </div>

      <aside class="tools-rail" aria-label="Sponsored">
        <AdSlot name="sidebar" />
      </aside>
    </div>
  </section>

  <!-- S3: Region-aware compliance shelf. The visitor's region is moved to the front. -->
  <section class="screen countries-section bg-band" aria-labelledby="country-heading">
    <div class="wrap">
      <header class="section-head">
        <div>
          <p class="eyebrow">International compliance</p>
          <h2 id="country-heading">Invoicing rules that fit the market</h2>
          <p class="section-lede">
            Tax IDs, mandatory fields, reverse-charge notes and verified rates
            for eight major markets. Your region is shown first.
          </p>
        </div>
        <a href="/countries/" class="link-draw text-link">All country guides <span aria-hidden="true">→</span></a>
      </header>

      <div class="country-grid" data-country-grid>
        {countries.map((c) => (
          <a
            href={c.href}
            class="country-tile sq"
            data-region={c.region}
            data-code={c.code}
          >
            <span class="country-code">{c.code}</span>
            <strong>{c.name}</strong>
            <span class="country-note">{c.note}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- S4: One quiet proof moment. Three steps, three squircle cards. -->
  <section class="screen precision-section" aria-labelledby="how-heading">
    <div class="wrap">
      <header class="section-head">
        <div>
          <p class="eyebrow">Under the hood</p>
          <h2 id="how-heading">The maths stays honest</h2>
        </div>
        <a href="/calculators/hourly-rate-calculator/" class="link-draw text-link">Open the calculator <span aria-hidden="true">→</span></a>
      </header>

      <div class="steps-grid">
        <article class="step-card sq">
          <span class="step-no">01</span>
          <h3>Enter your numbers</h3>
          <p>Income target, costs, working weeks and billable hours. Nothing leaves the browser.</p>
          <p class="step-readout"><span>Income target</span><b>$80,000</b></p>
          <p class="step-readout"><span>Billable hours</span><b>{exampleHours}/yr</b></p>
        </article>
        <article class="step-card sq">
          <span class="step-no">02</span>
          <h3>See the real rate</h3>
          <p>The rate covers costs first, then pays the income you asked for, down to the cent.</p>
          <p class="step-figure">{exampleRate}<small> per hour</small></p>
          <p class="step-readout"><span>Revenue needed</span><b>{exampleRevenue}</b></p>
        </article>
        <article class="step-card sq">
          <span class="step-no">03</span>
          <h3>Price the work</h3>
          <p>Quote a project and see what you would actually take home.</p>
          <p class="step-figure">{exampleQuote}<small> for 40 h</small></p>
          <p class="step-readout"><span>No account</span><b>No upload</b></p>
        </article>
      </div>
    </div>
  </section>

  <!-- S5: Closing action, then the below-the-fold ad after the promise. -->
  <section class="screen closing-section bg-band" aria-labelledby="close-heading">
    <div class="wrap">
      <div class="closing-panel sq">
        <div>
          <p class="eyebrow">Ready when you are</p>
          <h2 id="close-heading">Two minutes with real numbers beats another guess.</h2>
          <p class="section-lede">Free, private, and open on the first click.</p>
        </div>
        <div class="closing-actions">
          <a href="/calculators/hourly-rate-calculator/" class="btn btn-primary sq">Calculate your hourly rate</a>
          <button type="button" class="btn btn-secondary sq" data-open-palette>Open command palette <kbd>⌘K</kbd></button>
        </div>
      </div>

      <ul class="promise-list">
        <li><strong>Private by design</strong><span>Nothing you type leaves your browser. No account, no uploads, no beacons.</span></li>
        <li><strong>Exact, not approximate</strong><span>Arbitrary-precision decimal arithmetic and tested formulas, including extreme values.</span></li>
        <li><strong>No dark patterns</strong><span>Every result is free on the first screen. No paywalls, no email gates, no fake urgency.</span></li>
      </ul>

      <AdSlot name="end" />
    </div>
  </section>

  <!-- Mobile anchor: reserved inset from first paint, dismissible, shown after consent. -->
  <AdSlot name="anchor" />
</BaseLayout>

<script>
  import { sendEvent } from '@/lib/analytics';
  import { dispatchIntent } from '@/lib/intents';
  import { getRegionId } from '@/lib/prefs';

  document.querySelectorAll<HTMLElement>('[data-quick]').forEach((button) => {
    button.addEventListener('click', () => {
      const action = button.dataset.quick ?? 'unknown';
      sendEvent('quick_action', { action });
      // Through the intent bridge: the dashboard islands hydrate on idle,
      // and a very fast tap can land before their listeners exist. The
      // bridge queues the intent so it is never lost.
      if (action === 'timer') dispatchIntent('soloyolo:timer-toggle');
      if (action === 'clients') dispatchIntent('soloyolo:focus-clients');
    });
  });

  // Gestalt proximity: the visitor's own market leads the compliance shelf.
  const grid = document.querySelector<HTMLElement>('[data-country-grid]');
  if (grid) {
    const region = getRegionId();
    const tiles = Array.from(grid.querySelectorAll<HTMLElement>('.country-tile'));
    tiles
      .sort((a, b) => Number(b.dataset.region === region) - Number(a.dataset.region === region))
      .forEach((tile) => grid.appendChild(tile));
  }
</script>
