---
const pathname = Astro.url.pathname;

const navItems = [{ label: 'Calculators', href: '/calculators/' }] as const;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  const section = href.split('/').filter(Boolean)[0];
  return pathname.startsWith(`/${section}/`);
}
---

<header class="border-b border-line bg-canvas no-print">
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2.5 rounded-md py-1" aria-label="Ledgerly home">
      <svg
        width="28"
        height="28"
        viewBox="0 0 28 28"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        class="shrink-0"
      >
        <rect width="28" height="28" rx="7" fill="#0f5f4f"></rect>
        <path
          d="M8 9.25h12M8 14h8M8 18.75h5"
          stroke="#f4f2ec"
          stroke-width="1.75"
          stroke-linecap="round"
        ></path>
        <path
          d="M19 16.5v4M17 18.5h4"
          stroke="#b7d9cd"
          stroke-width="1.5"
          stroke-linecap="round"
        ></path>
      </svg>
      <span class="font-serif text-[1.35rem] leading-none font-semibold tracking-tight">
        Ledgerly
      </span>
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-md px-3 py-2 text-sm font-medium transition-colors',
            isActive(item.href) ? 'text-ink' : 'text-ink-soft hover:bg-[#f0eee8] hover:text-ink',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
