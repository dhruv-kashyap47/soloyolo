---
import { COUNTRY_GUIDES } from '@/lib/countries/guides';
import { TOOLS } from '@/lib/tools';
import wordmark from '@/assets/brand/wordmark-header.webp';

const pathname = Astro.url.pathname;

const liveCalculators = TOOLS.filter((tool) => tool.kind === 'calculator' && tool.live);
const liveGenerators = TOOLS.filter((tool) => tool.kind === 'generator' && tool.live);
const countryGuides = COUNTRY_GUIDES.filter((guide) => !guide.taxInvoice);

const navLinks = [
  { label: 'Calculators', href: '/calculators/' },
  { label: 'Generators', href: '/generators/' },
  { label: 'Countries', href: '/countries/' },
] as const;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  if (href === '/countries/') {
    return pathname.startsWith('/countries/') || /^\/(us|uk|ca|au|de|ch|in|ae)\//.test(pathname);
  }
  const section = href.split('/').filter(Boolean)[0];
  return pathname.startsWith(`/${section}/`);
}
---

<header class="nav no-print fixed inset-x-0 top-0 z-40 border-b border-line bg-canvas">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="flex min-h-11 shrink-0 items-center rounded-full py-1"
      aria-label="soloyolo home"
    >
      <img src={wordmark.src} width="300" height="89" alt="" class="h-7 w-auto sm:h-[1.9rem]" />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
      {navLinks.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'flex min-h-11 items-center rounded-full px-3 text-sm font-medium transition-colors',
            isActive(item.href) ? 'text-ink' : 'text-ink-soft hover:bg-surface-2 hover:text-ink',
          ]}
        >
          {item.label}
        </a>
      ))}

      <button
        type="button"
        id="header-search-trigger"
        class="ml-1 flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs text-ink-soft transition-colors hover:border-line-strong hover:text-ink"
        aria-label="Search tools"
        data-open-palette
      >
        <svg
          width="13"
          height="13"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
          class="text-accent-strong"
        >
          <path
            d="M7 12A5 5 0 1 0 7 2a5 5 0 0 0 0 10zm4.5-0.5L14 14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
        <span>Search</span>
      </button>

      <a
        href="/calculators/hourly-rate-calculator/"
        class="btn btn-primary sq btn-sm ml-2 min-h-11"
        aria-current={isActive('/calculators/hourly-rate-calculator/') ? 'page' : undefined}
      >
        Find your rate
      </a>
    </nav>

    <div class="flex items-center gap-1 md:hidden">
      <a
        href="/calculators/hourly-rate-calculator/"
        class="btn btn-primary sq min-h-11 px-3 text-xs"
        aria-current={isActive('/calculators/hourly-rate-calculator/') ? 'page' : undefined}
      >
        Find your rate
      </a>

      <button
        type="button"
        class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full text-ink-soft transition-colors hover:bg-surface-2 hover:text-ink"
        aria-label="Search tools"
        data-open-palette
      >
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M7 12A5 5 0 1 0 7 2a5 5 0 0 0 0 10zm4.5-0.5L14 14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
      </button>

      <button
        type="button"
        id="menu-toggle"
        class="flex h-11 w-11 items-center justify-center rounded-full text-ink transition-colors hover:bg-surface-2"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
          data-menu-open-icon
        >
          <path
            d="M3 5.5h14M3 10h14M3 14.5h14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
        <svg
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          aria-hidden="true"
          data-menu-close-icon
          class="hidden"
        >
          <path
            d="m4 4 10 10M14 4 4 14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    hidden
    role="dialog"
    aria-modal="true"
    class="fixed inset-x-0 bottom-0 top-16 z-40 overflow-y-auto border-t border-line bg-canvas px-5 pb-10 pt-4 md:hidden"
    aria-label="Mobile menu"
  >
    <nav aria-label="Primary mobile">
      <a href="/calculators/hourly-rate-calculator/" class="btn btn-primary sq mb-3 flex w-full">
        Find your rate
      </a>

      <button
        type="button"
        class="mb-4 flex w-full cursor-pointer items-center justify-between gap-2 rounded-xl border border-line bg-surface-2 px-4 py-3 text-sm text-ink-soft hover:text-ink"
        data-open-palette
      >
        <span class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="text-accent-strong">
            <path
              d="M7 12A5 5 0 1 0 7 2a5 5 0 0 0 0 10zm4.5-0.5L14 14"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
          <span>Search all tools and guides</span>
        </span>
        <kbd
          aria-hidden="true"
          class="rounded border border-line bg-surface px-1.5 py-0.5 font-mono text-xs font-semibold text-ink"
        >
          ⌘K
        </kbd>
      </button>

      <ul class="grid gap-1">
        {navLinks.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex min-h-11 items-center justify-between rounded-xl border border-line bg-surface px-4 py-3 text-[0.9375rem] font-semibold text-ink transition-colors hover:border-line-strong"
            >
              {item.label}
              <span aria-hidden="true" class="text-muted">→</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="mt-6 text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">
        Calculators
      </p>
      <ul class="mt-2 grid gap-1">
        {liveCalculators.map((tool) => (
          <li>
            <a
              href={tool.href}
              class="group flex items-center justify-between gap-3 rounded-xl border border-line bg-surface px-4 py-3.5 transition-colors hover:border-line-strong"
            >
              <span class="text-[0.9375rem] font-semibold text-ink group-hover:text-accent-strong">
                {tool.name}
              </span>
              <span aria-hidden="true" class="text-muted">→</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="mt-6 text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">
        Generators
      </p>
      <ul class="mt-2 grid gap-1">
        {liveGenerators.map((tool) => (
          <li>
            <a
              href={tool.href}
              class="group flex items-center justify-between gap-3 rounded-xl border border-line bg-surface px-4 py-3.5 transition-colors hover:border-line-strong"
            >
              <span class="text-[0.9375rem] font-semibold text-ink group-hover:text-accent-strong">
                {tool.name}
              </span>
              <span aria-hidden="true" class="text-muted">→</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="mt-6 text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">
        Country guides
      </p>
      <ul class="mt-2 flex flex-wrap gap-1.5">
        {countryGuides.map((guide) => (
          <li>
            <a
              href={guide.href}
              class="inline-flex min-h-11 items-center rounded-full border border-line px-3 text-xs text-ink-soft hover:border-line-strong hover:text-ink"
            >
              {guide.navLabel}
            </a>
          </li>
        ))}
      </ul>

      <ul class="mt-8 grid gap-1 border-t border-line pt-4">
        <li>
          <a
            href="/about/"
            class="flex min-h-11 items-center rounded-lg px-2 text-[0.9375rem] font-medium text-ink-soft transition-colors hover:text-ink"
          >
            About
          </a>
        </li>
        <li>
          <a
            href="/contact/"
            class="flex min-h-11 items-center rounded-lg px-2 text-[0.9375rem] font-medium text-ink-soft transition-colors hover:text-ink"
          >
            Contact
          </a>
        </li>
        <li>
          <a
            href="/privacy/"
            class="flex min-h-11 items-center rounded-lg px-2 text-[0.9375rem] font-medium text-ink-soft transition-colors hover:text-ink"
          >
            Privacy
          </a>
        </li>
        <li>
          <a
            href="/terms/"
            class="flex min-h-11 items-center rounded-lg px-2 text-[0.9375rem] font-medium text-ink-soft transition-colors hover:text-ink"
          >
            Terms
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <slot />
</header>

<script>
  // Mobile menu sheet.
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    let lastFocus: HTMLElement | null = null;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
      const openIcon = toggle.querySelector('[data-menu-open-icon]');
      const closeIcon = toggle.querySelector('[data-menu-close-icon]');
      if (openIcon && closeIcon) {
        openIcon.classList.toggle('hidden', open);
        closeIcon.classList.toggle('hidden', !open);
      }
      if (open) {
        lastFocus = document.activeElement as HTMLElement;
        menu.querySelector<HTMLElement>('a, button')?.focus();
      } else if (lastFocus?.isConnected) {
        lastFocus.focus();
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
      }
    });

    // Keep Tab inside the open sheet.
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const focusable = Array.from(
        menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex="0"]'),
      ).filter((element) => element.offsetParent !== null);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    // A menu left open while the window grows to the desktop nav would keep the
    // page locked (body overflow hidden) with no visible way back.
    const desktop = window.matchMedia('(min-width: 768px)');
    desktop.addEventListener('change', () => {
      if (desktop.matches && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
  }
</script>
