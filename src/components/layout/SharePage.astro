---
/**
 * One page-level share action for every tool page.
 *
 * It shares the page URL with the system share sheet where the browser has
 * one, and copies the link otherwise. Result copying stays inside each tool.
 */
---

<div class="share-page">
  <button type="button" class="share-page-button" data-share-page>
    <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path
        d="M10 2.5v9M6.5 6 10 2.5 13.5 6M5 10.5H3.5v7h13v-7H15"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    Share this page
  </button>
  <span class="share-page-status" role="status" aria-live="polite" data-share-status></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-share-page]').forEach((button) => {
    button.addEventListener('click', async () => {
      const status = button.parentElement?.querySelector<HTMLElement>('[data-share-status]');
      const url = window.location.href;

      if (typeof navigator.share === 'function') {
        try {
          await navigator.share({ title: document.title, url });
          if (status) status.textContent = 'Shared.';
          return;
        } catch (error) {
          if ((error as DOMException)?.name === 'AbortError') return;
        }
      }

      try {
        await navigator.clipboard.writeText(url);
        if (status) status.textContent = 'Link copied.';
      } catch {
        if (status) status.textContent = 'Copy unavailable.';
      }

      window.setTimeout(() => {
        if (status) status.textContent = '';
      }, 2500);
    });
  });
</script>
