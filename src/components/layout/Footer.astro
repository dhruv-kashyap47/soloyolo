---
import { TOOLS } from '@/lib/tools';
import logoMark from '@/assets/brand/logo-mark.png';

const liveCalculators = TOOLS.filter((tool) => tool.kind === 'calculator' && tool.live);
const year = new Date().getFullYear();
---

<footer class="no-print border-t border-line bg-band text-ink">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="flex items-center gap-2.5">
        <img
          src={logoMark.src}
          width="26"
          height="26"
          alt=""
          loading="lazy"
        />
        <span class="text-lg font-bold tracking-tight">soloyolo</span>
      </p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
        Free, privacy-first business tools for freelancers, consultants and small service
        businesses. Every calculation runs in your browser — no account, no uploads.
      </p>
    </div>

    <div>
      <p class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">Calculators</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {liveCalculators.map((tool) => (
          <li>
            <a
              class="link-draw inline-block text-ink-soft hover:text-ink"
              href={tool.href}
            >
              {tool.name}
            </a>
          </li>
        ))}
        <li>
          <a class="link-draw inline-block text-ink-soft hover:text-ink" href="/calculators/">
            All calculators
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">Site</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a class="link-draw inline-block text-ink-soft hover:text-ink" href="/about/">About</a></li>
        <li><a class="link-draw inline-block text-ink-soft hover:text-ink" href="/contact/">Contact</a></li>
        <li><a class="link-draw inline-block text-ink-soft hover:text-ink" href="/privacy/">Privacy policy</a></li>
        <li><a class="link-draw inline-block text-ink-soft hover:text-ink" href="/terms/">Terms of use</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container-page flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} SoloYolo. All rights reserved.</p>
      <p>Informational tools only — not tax, legal or financial advice.</p>
    </div>
  </div>
</footer>
