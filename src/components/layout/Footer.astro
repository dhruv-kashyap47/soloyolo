---
import { TOOLS } from '@/lib/tools';

const liveCalculators = TOOLS.filter((tool) => tool.kind === 'calculator' && tool.live);
const year = new Date().getFullYear();
---

<footer class="no-print mt-24 bg-footer text-ink-invert">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="font-serif text-xl font-semibold tracking-tight">Ledgerly</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-[#b9bdb8]">
        Free, privacy-first business tools for freelancers, consultants and small service
        businesses. Every calculation runs in your browser — no account, no uploads.
      </p>
    </div>

    <div>
      <p class="text-xs font-semibold tracking-[0.12em] text-[#8d938e] uppercase">Calculators</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {liveCalculators.map((tool) => (
          <li>
            <a
              class="text-[#d8dbd5] underline-offset-4 hover:text-white hover:underline"
              href={tool.href}
            >
              {tool.name}
            </a>
          </li>
        ))}
        <li>
          <a
            class="text-[#d8dbd5] underline-offset-4 hover:text-white hover:underline"
            href="/calculators/"
          >
            All calculators
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold tracking-[0.12em] text-[#8d938e] uppercase">Principles</p>
      <ul class="mt-4 space-y-2.5 text-sm text-[#b9bdb8]">
        <li>Private by default</li>
        <li>Exact decimal math</li>
        <li>No sign-up required</li>
        <li>Built for US, UK, CA &amp; AU</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-5 text-xs text-[#8d938e] sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Ledgerly. All rights reserved.</p>
      <p>Informational tools only — not tax, legal or financial advice.</p>
    </div>
  </div>
</footer>
