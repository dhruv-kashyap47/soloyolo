---
import { TOOLS } from '@/lib/tools';
import wordmarkLarge from '@/assets/brand/wordmark-footer-hd.webp';

const liveCalculators = TOOLS.filter((tool) => tool.kind === 'calculator' && tool.live);
const liveGenerators = TOOLS.filter((tool) => tool.kind === 'generator' && tool.live);
const year = new Date().getFullYear();
---

<footer class="closing no-print screen bg-band text-ink">
  <div class="wrap flex flex-1 flex-col gap-12">
    <div class="grid grid-cols-12 gap-x-6 gap-y-8">
      <div class="col-span-12 sm:col-span-6 lg:col-span-6">
        <p class="max-w-sm text-sm leading-relaxed text-ink-soft">
          Precise numbers for independent work. All in your browser.
        </p>
      </div>

      <div class="col-span-6 lg:col-start-7 lg:col-span-2">
        <p class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">Calculators</p>
        <ul class="mt-1 text-sm">
          {liveCalculators.map((tool) => (
            <li>
              <a class="footer-link link-draw text-ink-soft hover:text-ink" href={tool.href}>
                {tool.name}
              </a>
            </li>
          ))}
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/calculators/">
              All calculators
            </a>
          </li>
        </ul>
      </div>

      <div class="col-span-6 lg:col-span-2">
        <p class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">Generators</p>
        <ul class="mt-1 text-sm">
          {liveGenerators.map((tool) => (
            <li>
              <a class="footer-link link-draw text-ink-soft hover:text-ink" href={tool.href}>
                {tool.name}
              </a>
            </li>
          ))}
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/generators/">
              All generators
            </a>
          </li>
        </ul>
      </div>

      <div class="col-span-6 lg:col-span-2">
        <p class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">Site</p>
        <ul class="mt-1 text-sm">
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/about/">
              About
            </a>
          </li>
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/contact/">
              Contact
            </a>
          </li>
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/privacy/">
              Privacy policy
            </a>
          </li>
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/terms/">
              Terms of use
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- The close: the oversized wordmark blended into the band, one quiet line under it -->
    <div class="mt-auto">
      <img
        src={wordmarkLarge.src}
        width="1442"
        height="425"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        class="footer-wordmark select-none pointer-events-none"
        data-reveal
      />
      <p class="mx-auto mt-6 max-w-xl text-center text-sm leading-relaxed text-muted">
        Know your number. Own the work.
      </p>
    </div>

    <div class="flex flex-col gap-2 border-t border-line pt-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} SoloYolo. All rights reserved.</p>
      <p>Informational tools only: not tax, legal or financial advice.</p>
    </div>
  </div>
</footer>
