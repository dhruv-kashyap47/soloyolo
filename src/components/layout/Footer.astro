---
import { TOOLS } from '@/lib/tools';
import wordmark from '@/assets/brand/wordmark-header.webp';
import wordmarkLarge from '@/assets/brand/wordmark-footer.webp';

const liveCalculators = TOOLS.filter((tool) => tool.kind === 'calculator' && tool.live);
const year = new Date().getFullYear();
---

<footer class="closing no-print screen bg-band text-ink">
  <div class="wrap flex flex-1 flex-col justify-between gap-10">
    <div class="flex flex-col gap-10">
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 sm:col-span-6 lg:col-span-6">
          <p>
            <img
              src={wordmark.src}
              width="400"
              height="118"
              alt="SoloYolo"
              loading="lazy"
              class="h-7 w-auto"
            />
          </p>
          <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
            Free, privacy-first business tools for freelancers, consultants and small service
            businesses. Every calculation runs in your browser: no account, no uploads.
          </p>
        </div>

        <div class="col-span-6 lg:col-start-7 lg:col-span-3">
          <p class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">Calculators</p>
          <ul class="mt-1 text-sm">
            {liveCalculators.map((tool) => (
              <li>
                <a class="footer-link link-draw text-ink-soft hover:text-ink" href={tool.href}>
                  {tool.name}
                </a>
              </li>
            ))}
            <li>
              <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/calculators/">
                All calculators
              </a>
            </li>
          </ul>
        </div>

        <div class="col-span-6 lg:col-span-3">
          <p class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">Site</p>
          <ul class="mt-1 text-sm">
            <li><a class="footer-link link-draw text-ink-soft hover:text-ink" href="/about/">About</a></li>
            <li><a class="footer-link link-draw text-ink-soft hover:text-ink" href="/contact/">Contact</a></li>
            <li><a class="footer-link link-draw text-ink-soft hover:text-ink" href="/privacy/">Privacy policy</a></li>
            <li><a class="footer-link link-draw text-ink-soft hover:text-ink" href="/terms/">Terms of use</a></li>
          </ul>
        </div>
      </div>

      <!-- The dealt moment: the wordmark set large, one quiet line under it -->
      <div class="mt-auto">
        <img
          src={wordmarkLarge.src}
          width="900"
          height="265"
          alt=""
          aria-hidden="true"
          loading="lazy"
          class="h-auto w-full max-w-[34rem]"
        />
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted">
          Find the rate that funds your year, then price the work with numbers you trust.
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-2 border-t border-line pt-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} SoloYolo. All rights reserved.</p>
      <p>Informational tools only: not tax, legal or financial advice.</p>
    </div>
  </div>
</footer>
