---
import { Image } from 'astro:assets';
import { COUNTRY_GUIDES } from '@/lib/countries/guides';
import { TOOLS } from '@/lib/tools';
import { SITE } from '@/config/site';
import wordmarkLarge from '@/assets/brand/wordmark-footer-hd.webp';

const liveCalculators = TOOLS.filter((tool) => tool.kind === 'calculator' && tool.live);
const liveGenerators = TOOLS.filter((tool) => tool.kind === 'generator' && tool.live);
const countryGuides = COUNTRY_GUIDES.filter((guide) => !guide.taxInvoice);
const year = new Date().getFullYear();
---

<footer class="closing no-print screen bg-band text-ink">
  <div class="wrap flex flex-1 flex-col gap-12">
    <div class="grid grid-cols-12 gap-x-6 gap-y-8">
      <div class="col-span-12 sm:col-span-6 lg:col-span-4">
        <p class="max-w-sm text-sm leading-relaxed text-ink-soft">
          Precise numbers for independent work. All in your browser.
        </p>
      </div>

      <div class="col-span-6 lg:col-span-2">
        <p class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">Calculators</p>
        <ul class="mt-1 text-sm">
          {liveCalculators.map((tool) => (
            <li>
              <a class="footer-link link-draw text-ink-soft hover:text-ink" href={tool.href}>
                {tool.name}
              </a>
            </li>
          ))}
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/calculators/">
              All calculators
            </a>
          </li>
        </ul>
      </div>

      <div class="col-span-6 lg:col-span-2">
        <p class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">Generators</p>
        <ul class="mt-1 text-sm">
          {liveGenerators.map((tool) => (
            <li>
              <a class="footer-link link-draw text-ink-soft hover:text-ink" href={tool.href}>
                {tool.name}
              </a>
            </li>
          ))}
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/generators/">
              All generators
            </a>
          </li>
        </ul>
      </div>

      <div class="col-span-6 lg:col-span-2">
        <p class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">Countries</p>
        <ul class="mt-1 text-sm">
          {countryGuides.map((guide) => (
            <li>
              <a class="footer-link link-draw text-ink-soft hover:text-ink" href={guide.href}>
                {guide.navLabel}
              </a>
            </li>
          ))}
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/countries/">
              All country guides
            </a>
          </li>
        </ul>
      </div>

      <div class="col-span-6 lg:col-span-2">
        <p class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">Site</p>
        <ul class="mt-1 text-sm">
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/about/">
              About
            </a>
          </li>
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/contact/">
              Contact
            </a>
          </li>
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/privacy/">
              Privacy policy
            </a>
          </li>
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/terms/">
              Terms of use
            </a>
          </li>
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/disclaimer/">
              Disclaimer
            </a>
          </li>
          <li>
            <a class="footer-link link-draw text-ink-soft hover:text-ink" href="/resources/">
              Resources
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-auto">
      <Image
        src={wordmarkLarge}
        width={400}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        class="footer-wordmark select-none pointer-events-none"
      />
      <p class="mx-auto mt-6 max-w-xl text-center text-sm leading-relaxed text-muted">
        Know your number. Own the work.
      </p>
    </div>

    <div
      class="flex flex-col gap-3 border-t border-line pt-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="theme-switch" role="group" aria-label="Colour theme">
        <span class="theme-switch-label" aria-hidden="true">Theme</span>
        <div class="theme-switch-options">
          <button type="button" data-theme-choice="auto" aria-pressed="true">Auto</button>
          <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
          <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 sm:justify-end">
        <p>&copy; {year} {SITE.operator}. All rights reserved.</p>
        <p>Informational tools only: not tax, legal or financial advice.</p>
      </div>
    </div>
  </div>
</footer>

<script>
  // Theme switch: three states, stored for the next visit. The head bootstrap
  // has already applied the choice; this only records a change and repaints.
  const root = document.documentElement;
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.theme-switch [data-theme-choice]'),
  );
  const query = window.matchMedia('(prefers-color-scheme: light)');

  const paint = (choice: string, resolved: string) => {
    root.setAttribute('data-theme', resolved);
    root.setAttribute('data-theme-choice', choice);
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', resolved === 'light' ? '#f6f3ec' : '#000000');
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.themeChoice === choice));
    }
  };

  const resolve = (choice: string) =>
    choice === 'auto' ? (query.matches ? 'light' : 'dark') : choice;

  paint(root.getAttribute('data-theme-choice') ?? 'auto', root.getAttribute('data-theme') ?? 'dark');

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const choice = button.dataset.themeChoice ?? 'auto';
      try {
        localStorage.setItem('soloyolo-theme', choice);
      } catch {
        /* storage blocked: the choice holds for this page view */
      }
      paint(choice, resolve(choice));
    });
  }

  // Auto means auto: follow the OS if it changes while the page is open.
  query.addEventListener('change', () => {
    if ((root.getAttribute('data-theme-choice') ?? 'auto') === 'auto') {
      paint('auto', resolve('auto'));
    }
  });
</script>
