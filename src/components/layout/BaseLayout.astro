---
import '@/styles/global.css';
import ConsentBanner from '@/components/ads/ConsentBanner.astro';
import CommandPalette from '@/components/home/CommandPalette';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import SEO from '@/components/seo/SEO.astro';
import { SITE } from '@/config/site';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  jsonLd?: readonly Record<string, unknown>[];
}

const { title, description, path, noindex, type, jsonLd } = Astro.props;

// AdSense is only wired when a publisher id is configured, and the script is
// injected from the client only after consent (ConsentBanner). It never blocks
// rendering: the tag is created asynchronously after the page is interactive.
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT ?? '';

// The home page reserves a mobile anchor-ad inset from the first frame so the
// unit can appear later without shifting the tools or their controls.
const isHome = path === '/';

// One colour family per kind of page, used by the accent tokens in global.css.
const family = isHome
  ? 'home'
  : path.startsWith('/generators/')
    ? 'generators'
    : path.startsWith('/countries/') || /^\/(us|uk|ca|au|de|ch|in|ae)\//.test(path)
      ? 'countries'
      : path.startsWith('/calculators/')
        ? 'calculators'
        : 'site';

const siteUrl = Astro.site ?? new URL('https://soloyolo.example.com');
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', siteUrl).href,
  name: SITE.name,
  url: siteUrl.href,
  description: SITE.description,
  logo: new URL('/apple-touch-icon.png', siteUrl).href,
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', siteUrl).href,
  name: SITE.name,
  url: siteUrl.href,
  inLanguage: 'en',
  publisher: { '@id': organisation['@id'] },
};
const baseJsonLd = [organisation, website, ...(jsonLd ?? [])];
---

<!doctype html>
<html lang="en" data-page={isHome ? 'home' : 'tool'} data-family={family}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/outfit-latin-wght-normal.woff2" crossorigin />
    <SEO
      title={title}
      description={description}
      path={path}
      noindex={noindex}
      type={type}
      jsonLd={baseJsonLd}
    />
    {
      adsenseClient && (
        <script is:inline define:vars={{ adsenseClient }}>
          // Consent gate: the AdSense loader is injected once, only after the
          // visitor chose "Accept all". Without consent no ad script runs.
          (function () {
            let loaded = false;
            function loadAds() {
              if (loaded) return;
              loaded = true;
              const inject = function () {
                // Legal and information pages carry no slot: do not load the
                // ad library (or its cookies) where there is nothing to fill.
                if (!document.querySelector('.ad-slot[data-network="adsense"]')) {
                  loaded = false;
                  // The head can run before the body exists; try once the DOM
                  // is ready rather than losing a stored consent.
                  if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', loadAds, { once: true });
                  }
                  return;
                }
                const s = document.createElement('script');
                s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + adsenseClient;
                s.async = true;
                s.defer = true;
                s.crossOrigin = 'anonymous';
                document.head.appendChild(s);
              };
              // The ad library is never competing with first paint.
              if (window.requestIdleCallback) window.requestIdleCallback(inject, { timeout: 2000 });
              else window.setTimeout(inject, 600);
            }
            const allowed = function (value) {
              return value === 'all' || Boolean(value && value.ads === true);
            };
            try {
              const stored = localStorage.getItem('soloyolo-consent');
              if (allowed(stored === 'all' ? 'all' : JSON.parse(stored || 'null'))) loadAds();
            } catch {
              /* storage unavailable or malformed: no ad tag */
            }
            window.addEventListener('soloyolo:consent', function (event) {
              if (allowed(event.detail)) loadAds();
            });
          })();
        </script>
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header>
      <ConsentBanner />
    </Header>
    <main id="main" class:list={['flex-1', !isHome && 'pt-16', isHome && 'home-main']}>
      <slot />
    </main>
    <Footer />
    <CommandPalette client:idle />
    <script>
      import { startSession } from '@/lib/analytics';

      startSession(location.pathname);

      // Palette bridge: runs eagerly, before the idle island hydrates, so the
      // header search button and Cmd/Ctrl+K respond immediately. Clicks and
      // hotkeys dispatch events the palette listens for; if the island has
      // not hydrated yet, a pending flag makes it open as soon as it mounts.
      const closeMobileMenu = () => {
        const toggle = document.getElementById('menu-toggle');
        if (toggle?.getAttribute('aria-expanded') === 'true') toggle.click();
      };

      const requestPalette = (trigger?: HTMLElement) => {
        window.__soloyoloPalettePending = true;
        // Two full-screen layers at once would fight over the scroll lock.
        closeMobileMenu();
        window.dispatchEvent(new CustomEvent('soloyolo:open-palette', { detail: { trigger } }));
      };

      document.addEventListener('click', (event) => {
        const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-open-palette]');
        if (trigger) requestPalette(trigger);
      });

      window.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          closeMobileMenu();
          window.__soloyoloPalettePending = true;
          window.dispatchEvent(new Event('soloyolo:palette-hotkey'));
        }
      });

      // Show the shortcut this keyboard actually has. The handler accepts
      // both; the hint should not promise a key the device lacks.
      const isApple = /Mac|iPhone|iPad|iPod/.test(navigator.userAgent);
      if (!isApple) {
        document.querySelectorAll('kbd').forEach((kbd) => {
          const text = kbd.textContent?.trim();
          if (text === '⌘K') kbd.textContent = 'Ctrl K';
          else if (text === '⌘↵') kbd.textContent = 'Ctrl ↵';
        });
      }

      const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const motionOk = !matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reveals.length && motionOk && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        reveals.forEach((element) => observer.observe(element));
        document.documentElement.classList.add('reveal-ready');
      }
    </script>
  </body>
</html>
