---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: readonly Crumb[];
}

const { items } = Astro.props;
const site = Astro.site ?? new URL('https://soloyolotools.com');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, site).href } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class="pt-6">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && (
          <span aria-hidden="true" class="text-line-strong">
            /
          </span>
        )}
        {item.href ? (
          <a
            href={item.href}
            class="-my-3 inline-block rounded-sm py-3 underline-offset-2 hover:text-ink hover:underline"
          >
            {item.label}
          </a>
        ) : (
          <span aria-current="page" class="font-medium text-ink-soft">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
