---
import type { Tool } from '@/lib/tools';

interface Props {
  tool: Tool;
  /**
   * Optional small label above the tool name. The hub pages leave it out:
   * every card on a page titled "Calculators" repeated the same badge, which
   * was noise rather than information.
   */
  badge?: string;
}

const { tool, badge } = Astro.props;
---

<a href={tool.href} class="card card-hover group flex h-full flex-col p-6" data-reveal>
  <span class="flex items-center justify-between gap-3">
    <span class="text-[0.6875rem] font-semibold tracking-[0.1em] text-muted uppercase">
      {badge ?? ''}
    </span>
    <span
      aria-hidden="true"
      class="text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-accent-strong"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path
          d="M3 8h9.5M9 4.5 12.5 8 9 11.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </span>
  </span>
  <span class="mt-3 text-lg font-semibold tracking-tight text-ink group-hover:text-accent-strong">
    {tool.name}
  </span>
  <span class="mt-2 text-sm leading-relaxed text-ink-soft">{tool.summary}</span>
</a>
