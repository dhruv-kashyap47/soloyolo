---
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: readonly Faq[];
  title?: string;
}

const { faqs, title = 'Frequently asked questions' } = Astro.props;
---

<section class="mt-14 scroll-mt-8 sm:mt-16" aria-labelledby="faq-heading">
  <h2
    id="faq-heading"
    class="font-serif text-2xl leading-tight font-semibold tracking-tight sm:text-[1.75rem]"
  >
    {title}
  </h2>

  <div class="mt-5 max-w-3xl divide-y divide-line border-y border-line">
    {faqs.map((faq) => (
      <details class="group py-4">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-[0.9375rem] font-semibold text-ink [&::-webkit-details-marker]:hidden">
          <span>{faq.question}</span>
          <span
            aria-hidden="true"
            class="mt-0.5 shrink-0 text-muted transition-transform group-open:rotate-45"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path
                d="M8 3v10M3 8h10"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </svg>
          </span>
        </summary>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-soft">{faq.answer}</p>
      </details>
    ))}
  </div>
</section>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  })}
/>
