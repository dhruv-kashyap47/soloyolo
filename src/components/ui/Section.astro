---
interface Props {
  id?: string;
  title: string;
  description?: string;
  width?: 'prose' | 'wide';
}

const { id, title, description, width = 'prose' } = Astro.props;
---

<section id={id} class="mt-14 scroll-mt-8 sm:mt-16">
  <div class={width === 'prose' ? 'max-w-3xl' : ''}>
    <h2 class="text-[clamp(1.6rem,1.3rem+1.5vw,2rem)] font-medium leading-tight tracking-[-0.02em]">
      {title}
    </h2>
    {description && <p class="mt-3 text-ink-soft">{description}</p>}
  </div>
  <div class="mt-5">
    <slot />
  </div>
</section>
