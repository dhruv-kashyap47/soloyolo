---
import { GOOGLE_TAG_ID } from '@/config/analytics';
---

<!--
  Google Tag Manager (GTM-NJMCB9BQ).

  Rendered once by BaseLayout, so every page gets exactly one container. The
  consent default must run before the container so a visitor who has not chosen
  yet is measured with storage denied. The existing ConsentBanner sends the
  matching update when the visitor chooses.

  This is the official container snippet rather than a bare gtag.js include:
  the `gtm.start` push is what initialises the container and its GA4 tag.
-->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(...args) {
    dataLayer.push(args);
  }
  // Re-running this after a client-side navigation must not reset a choice
  // the visitor already made.
  if (!window.__soloyoloConsentDefault) {
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });
    gtag('js', new Date());
    window.__soloyoloConsentDefault = true;
  }
</script>
<script is:inline define:vars={{ GOOGLE_TAG_ID }}>
  // The container must exist once. Astro swaps the head during a client-side
  // navigation; this guard keeps that swap from inserting a second gtm.js.
  if (!window.__soloyoloGtmLoaded) {
    window.__soloyoloGtmLoaded = true;
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      const f = d.getElementsByTagName(s)[0];
      const j = d.createElement(s);
      const dl = l !== 'dataLayer' ? '&l=' + l : '';
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', GOOGLE_TAG_ID);
  }
</script>
<!-- End Google Tag Manager -->
