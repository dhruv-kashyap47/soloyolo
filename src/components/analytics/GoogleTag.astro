---
import { GOOGLE_TAG_ID } from '@/config/analytics';
import { CONSENT_KEY, CONSENT_VERSION } from '@/lib/consent';
---

<!--
  Google Tag Manager (GTM-NJMCB9BQ), consent-gated.

  Rendered once by BaseLayout so every page carries the same hashed inline
  bootstrap, but the bootstrap does not request gtm.js and does not create
  window.dataLayer until the visitor has explicitly accepted analytics.

  Consent Mode is set before the container is injected, with ad storage denied
  permanently (advertising is not enabled). A stored "Accept analytics" from an
  earlier visit counts as explicit consent; no choice and "Decline" never load
  the tag.
-->
<script is:inline define:vars={{ GOOGLE_TAG_ID, CONSENT_KEY, CONSENT_VERSION }}>
  (function () {
    function storedChoice() {
      try {
        const raw = localStorage.getItem(CONSENT_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed || parsed.version !== CONSENT_VERSION) return null;
        return parsed.analytics === true;
      } catch {
        return null;
      }
    }

    function consent(analytics) {
      return {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: analytics ? 'granted' : 'denied',
      };
    }

    function inject() {
      if (window.__soloyoloGtmLoaded) return;
      window.__soloyoloGtmLoaded = true;

      window.dataLayer = window.dataLayer || [];
      window.gtag =
        window.gtag ||
        function (...args) {
          window.dataLayer.push(args);
        };

      // Explicit consent has already been recorded, so analytics starts
      // granted; ad signals stay denied.
      window.gtag('consent', 'default', consent(true));
      window.gtag('js', new Date());
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });

      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtm.js?id=' + GOOGLE_TAG_ID;
      document.head.appendChild(script);
    }

    function deny() {
      // The tag can no longer be unloaded once requested. If it is already on
      // this page, withdraw measurement at the consent layer as well.
      if (window.__soloyoloGtmLoaded && window.gtag) {
        window.gtag('consent', 'update', consent(false));
      }
    }

    if (storedChoice() === true) inject();

    window.addEventListener('soloyolo:consent', function (event) {
      const detail = (event && event.detail) || {};
      if (detail.analytics === true) {
        if (window.__soloyoloGtmLoaded && window.gtag) {
          window.gtag('consent', 'update', consent(true));
        } else {
          inject();
        }
      } else {
        deny();
      }
    });
  })();
</script>
<!-- End Google Tag Manager -->
