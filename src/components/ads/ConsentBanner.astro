---
/**
 * Lightweight, dependency-free consent banner (cookie disclosure + gate).
 *
 * AdSense and any future third-party scripts are loaded ONLY after the visitor
 * makes a choice (see BaseLayout). The choice is stored in localStorage and
 * broadcast with a custom event. For EEA/UK traffic a Google-certified CMP is
 * the recommended long-term replacement — noted in the project checklist.
 */
---

<div
  id="consent-banner"
  role="dialog"
  aria-modal="false"
  aria-label="Cookie consent"
  hidden
  class="no-print fixed inset-x-3 bottom-3 z-50 mx-auto max-w-xl rounded-2xl border border-line bg-surface p-4 shadow-2xl sm:p-5"
>
  <p class="text-sm font-semibold text-ink">Cookies on soloyolo</p>
  <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">
    We use essential cookies to run the site. With your permission we also show
    ads that help keep every tool free — ad partners may then use cookies for
    measurement and personalisation. Read the
    <a href="/privacy/" class="font-medium text-accent-strong underline underline-offset-2">privacy policy</a>.
  </p>
  <div class="mt-3 flex flex-wrap gap-2">
    <button type="button" data-consent="all" class="btn btn-primary min-h-11">
      Accept all
    </button>
    <button type="button" data-consent="essential" class="btn btn-secondary min-h-11">
      Essential only
    </button>
  </div>
</div>

<script>
  const STORAGE_KEY = 'soloyolo-consent';

  type ConsentValue = 'all' | 'essential';

  function readConsent(): ConsentValue | null {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === 'all' || value === 'essential' ? value : null;
    } catch {
      return null;
    }
  }

  function broadcast(value: ConsentValue) {
    window.dispatchEvent(new CustomEvent('soloyolo:consent', { detail: value }));
  }

  const banner = document.getElementById('consent-banner');

  if (banner) {
    const existing = readConsent();

    if (existing) {
      broadcast(existing);
    } else {
      banner.hidden = false;
      banner.querySelectorAll<HTMLButtonElement>('button[data-consent]').forEach((button) => {
        button.addEventListener('click', () => {
          const value = (button.dataset.consent ?? 'essential') as ConsentValue;
          try {
            localStorage.setItem(STORAGE_KEY, value);
          } catch {
            /* storage blocked — choice applies to this page view only */
          }
          banner.hidden = true;
          broadcast(value);
        });
      });
    }
  }
</script>
