---
/**
 * Analytics consent.
 *
 * The Google tag is not requested until the visitor chooses "Accept analytics".
 * Declining, or making no choice, keeps it off. The choice is versioned and can
 * be changed later from the footer's "Cookie settings" control. Advertising is
 * not enabled, so ad storage is always denied and is not offered as a choice.
 *
 * The banner is a fixed corner card (a bottom sheet on a phone), hidden until
 * the script knows whether a choice exists, so showing it does not shift the
 * page. It has no modal focus trap: it can be dismissed with Escape or its two
 * buttons, and focus returns to the control that reopened it.
 */
---

<div
  id="consent-banner"
  role="dialog"
  aria-labelledby="consent-heading"
  hidden
  class="consent-card sq no-print border border-line bg-surface p-4 shadow-2xl sm:p-5"
>
  <p id="consent-heading" class="text-sm font-semibold text-ink">Your privacy, your call</p>
  <p class="mt-1 text-[0.8125rem] leading-snug text-ink-soft">
    Essential storage keeps your tools working. With your permission, Google Analytics may use
    cookies to measure which pages and tools are useful. Nothing you type in a tool is ever sent to
    a server. Read the{' '}
    <a href="/privacy/" class="font-medium text-accent-strong underline underline-offset-2">
      privacy policy
    </a>
    .
  </p>

  <div class="mt-3 flex flex-wrap gap-2">
    <button type="button" data-consent-accept class="btn btn-primary min-h-11 flex-1 sq">
      Accept analytics
    </button>
    <button type="button" data-consent-decline class="btn btn-secondary min-h-11 flex-1 sq">
      Decline
    </button>
  </div>
  <p class="text-muted mt-2 text-xs leading-snug">
    Decline, or no choice, means the Google tag is never requested. You can change this later via
    <span class="font-medium text-ink-soft">Cookie settings</span> in the footer.
  </p>
</div>

<script>
  import {
    CONSENT_VERSION,
    readConsent,
    saveConsent,
    type ConsentDetail,
  } from '@/lib/consent';

  const banner = document.getElementById('consent-banner');

  if (banner) {
    const accept = banner.querySelector<HTMLButtonElement>('[data-consent-accept]');
    const decline = banner.querySelector<HTMLButtonElement>('[data-consent-decline]');
    let restoreFocus: HTMLElement | null = null;

    const announce = (analytics: boolean) => {
      const detail: ConsentDetail = {
        version: CONSENT_VERSION,
        analytics,
        ads: false,
        value: analytics ? 'accepted' : 'declined',
      };
      window.dispatchEvent(new CustomEvent<ConsentDetail>('soloyolo:consent', { detail }));
    };

    const close = () => {
      banner.hidden = true;
      const target = restoreFocus?.isConnected ? restoreFocus : null;
      restoreFocus = null;
      if (target) target.focus({ preventScroll: true });
    };

    const open = (trigger?: HTMLElement) => {
      restoreFocus = trigger ?? null;
      banner.hidden = false;
      accept?.focus({ preventScroll: true });
    };

    const choose = (analytics: boolean) => {
      // A blocked storage API still lets the choice apply for this page view;
      // the banner will ask again on the next visit because nothing persisted.
      saveConsent(analytics);
      announce(analytics);
      close();
    };

    accept?.addEventListener('click', () => choose(true));
    decline?.addEventListener('click', () => choose(false));

    // Reopen from the footer on any page. The banner renders in the header,
    // before the footer exists, so listen at the document rather than binding
    // to controls that have not been parsed yet.
    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement | null)?.closest<HTMLElement>(
        '[data-open-consent]',
      );
      if (!trigger) return;
      event.preventDefault();
      open(trigger);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || banner.hidden) return;
      event.preventDefault();
      close();
    });

    const existing = readConsent();
    if (existing) {
      if (existing.migrated) {
        // An old "all"/"essential" answer carries over once, and the GTM
        // bootstrap is told immediately because it only reads the current key
        // at load time.
        saveConsent(existing.state.analytics);
        announce(existing.state.analytics);
      }
    } else {
      banner.hidden = false;
    }
  }
</script>
