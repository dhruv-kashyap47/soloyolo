{
  "name": "ledgerly-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first business calculators and document generators for freelancers and micro-businesses.",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "build:headers": "node scripts/build-headers.mjs",
    "check:no-beacon": "node scripts/check-no-beacon.mjs",
    "check:production": "node scripts/check-production-build.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "capture:third-parties": "node scripts/capture-third-parties.mjs",
    "uptime": "node scripts/uptime-probe.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:tablet": "playwright test --project=tablet-webkit",
    "test:e2e:smoke": "playwright test --project=cross-browser-chrome --project=cross-browser-edge --project=cross-browser-firefox --project=cross-browser-webkit",
    "perf:lighthouse": "pnpm build && node scripts/lighthouse.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.6",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "decimal.js": "^10.6.0",
    "preact": "^11.2.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "5.1.1",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "lighthouse": "^13.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "5.1.1",
    "wrangler": "4.169.0"
  }
}
