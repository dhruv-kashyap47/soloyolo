# Public base URL used for canonical links, sitemap and structured data.
# Set this in Cloudflare Pages (or a local .env file). No trailing slash.
PUBLIC_SITE_URL=https://ledgerly.example.com

# ---------------------------------------------------------------------------
# Google AdSense (leave empty while the site is not yet approved).
# PUBLIC_ADSENSE_CLIENT is the publisher id, e.g. ca-pub-1234567890123456.
# Slot ids come from the AdSense dashboard after creating four responsive
# display units. When PUBLIC_ADSENSE_CLIENT is empty the site renders neutral,
# reserved-height placeholders instead of ad code.
# ---------------------------------------------------------------------------
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_TOP=
PUBLIC_ADSENSE_SLOT_INARTICLE=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_END=
